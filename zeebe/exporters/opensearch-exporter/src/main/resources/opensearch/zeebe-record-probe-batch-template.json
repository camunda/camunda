{
  "index_patterns": [
    "zeebe-record_probe-batch_*"
  ],
  "composed_of": [
    "zeebe-record"
  ],
  "priority": 20,
  "version": 1,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": "1",
        "number_of_replicas": "1",
        "queries": {
          "cache": {
            "enabled": false
          }
        }
      }
    },
    "aliases": {
      "zeebe-record-probe-batch": {}
    },
    "mappings": {
      "properties": {
        "value": {
          "dynamic": "strict",
          "properties": {
            "probeId": {
              "type": "keyword"
            },
            "worker": {
              "type": "keyword"
            },
            "maxProbesToActivate": {
              "type": "integer"
            },
            "tenantIds": {
              "type": "keyword"
            },
            "tenantFilter": {
              "type": "keyword"
            },
            "probeKeys": {
              "type": "long"
            },
            "probes": {
              "enabled": false
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
