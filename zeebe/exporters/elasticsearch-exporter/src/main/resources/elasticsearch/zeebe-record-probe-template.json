{
  "index_patterns": [
    "zeebe-record_probe_*"
  ],
  "composed_of": [
    "zeebe-record"
  ],
  "priority": 20,
  "version": 1,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "index.queries.cache.enabled": false
    },
    "aliases": {
      "zeebe-record-probe": {}
    },
    "mappings": {
      "properties": {
        "value": {
          "dynamic": "strict",
          "properties": {
            "operation": {
              "type": "keyword"
            },
            "template": {
              "type": "keyword"
            },
            "tenantId": {
              "type": "keyword"
            },
            "inputExpression": {
              "type": "text"
            },
            "input": {
              "enabled": false
            },
            "secretReferences": {
              "properties": {
                "storeId": {
                  "type": "keyword"
                },
                "secretReference": {
                  "type": "keyword"
                },
                "path": {
                  "type": "keyword"
                }
              }
            },
            "requestTimeout": {
              "type": "long"
            },
            "deadline": {
              "type": "long"
            },
            "worker": {
              "type": "keyword"
            },
            "yieldCount": {
              "type": "integer"
            },
            "outcome": {
              "type": "keyword"
            },
            "data": {
              "enabled": false
            },
            "message": {
              "type": "text"
            },
            "endReason": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
