<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Liquibase would map BLOB to oid (a large object reference) on PostgreSQL, and TEXT can't be
    part of a primary key in every database.
  -->
  <property name="engineState.binaryType" value="BYTEA" dbms="postgresql"/>
  <property name="engineState.binaryType" value="BLOB"/>
  <property name="engineState.textType" value="TEXT" dbms="postgresql"/>
  <property name="engineState.textType" value="VARCHAR(4000)"/>

  <!--
    Every table has the process_instance_key, root_process_instance_key and tenant_id of the
    process instance its rows belong to, and an index on (partition_id, root_process_instance_key),
    so all rows of a process instance tree can be found (e.g. to delete them) in every table. The
    root key of a root process instance is its own key.
  -->

  <!--
    Element instances, as stored by RdbmsElementInstanceState.

    Hybrid row: the full ElementInstance is kept as its msgpack payload (the source of truth for
    reads). The remaining columns are derived from it on every write so they can be queried and
    indexed. parent_key is -1 for process instances, same as in the RocksDB state.
    parent_process_instance_key is the record's, -1 unless the row belongs to a called process
    instance.

    business_id is the business id of a process instance, root or called, and NULL for every other
    row, including a process instance without business id (Oracle stores an empty string as NULL
    anyway). Its rows with parent_process_instance_key -1 replace the RocksDB index of process
    instances by business id, which holds the same entries: the appliers insert an entry exactly
    when a process instance without parent process instance is created with or assigned a business
    id, and delete it in the same applier that removes the instance. The root_process_instance_key
    can't tell a root instance: it falls back to the own key for records written before it existed,
    also for called instances. Uniqueness is enforced by the engine, hence the index is not unique.
  -->
  <changeSet id="create-element-instance" author="camunda">
    <createTable tableName="CAM_RU_ELEMENT_INSTANCE">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="element_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="parent_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="root_process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="parent_process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="process_definition_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tenant_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="bpmn_process_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="business_id" type="${engineState.textType}"/>
      <column name="element_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="bpmn_element_type" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="state" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="payload" type="${engineState.binaryType}">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_ELEMENT_INSTANCE" constraintName="CAM_RU_ELEMENT_INSTANCE_PKEY"
      columnNames="partition_id, element_instance_key"/>
    <createIndex tableName="CAM_RU_ELEMENT_INSTANCE" indexName="CAM_RU_ELEMENT_INSTANCE_CHILDREN">
      <column name="partition_id"/>
      <column name="parent_key"/>
      <column name="element_instance_key"/>
    </createIndex>
    <createIndex tableName="CAM_RU_ELEMENT_INSTANCE" indexName="CAM_RU_ELEMENT_INSTANCE_ROOT_INSTANCE">
      <column name="partition_id"/>
      <column name="root_process_instance_key"/>
    </createIndex>
    <createIndex tableName="CAM_RU_ELEMENT_INSTANCE" indexName="CAM_RU_ELEMENT_INSTANCE_BY_BUSINESS_ID">
      <column name="partition_id"/>
      <column name="tenant_id"/>
      <column name="bpmn_process_id"/>
      <column name="business_id"/>
      <column name="parent_process_instance_key"/>
    </createIndex>
  </changeSet>

  <!--
    Process instances by definition key, and the active process instance count. Only the rows of
    process instances: 1 is the ordinal of BpmnElementType.PROCESS, which the queries inline.
  -->
  <changeSet id="create-element-instance-process-by-definition" author="camunda"
    dbms="postgresql">
    <sql>
      CREATE INDEX CAM_RU_ELEMENT_INSTANCE_PROCESS_BY_DEFINITION
        ON CAM_RU_ELEMENT_INSTANCE (partition_id, process_definition_key, element_instance_key)
        WHERE bpmn_element_type = 1
    </sql>
  </changeSet>
  <changeSet id="create-element-instance-process-by-definition-full" author="camunda"
    dbms="!postgresql">
    <createIndex tableName="CAM_RU_ELEMENT_INSTANCE" indexName="CAM_RU_ELEMENT_INSTANCE_PROCESS_BY_DEFINITION">
      <column name="partition_id"/>
      <column name="process_definition_key"/>
      <column name="element_instance_key"/>
    </createIndex>
  </changeSet>

  <!-- How often each sequence flow to a joining gateway was taken in a flow scope. -->
  <changeSet id="create-taken-sequence-flow" author="camunda">
    <createTable tableName="CAM_RU_TAKEN_SEQUENCE_FLOW">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="flow_scope_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="gateway_element_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="sequence_flow_element_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="root_process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tenant_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="times_taken" type="INT">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_TAKEN_SEQUENCE_FLOW" constraintName="CAM_RU_TAKEN_SEQUENCE_FLOW_PKEY"
      columnNames="partition_id, flow_scope_key, gateway_element_id, sequence_flow_element_id"/>
    <createIndex tableName="CAM_RU_TAKEN_SEQUENCE_FLOW" indexName="CAM_RU_TAKEN_SEQUENCE_FLOW_ROOT_INSTANCE">
      <column name="partition_id"/>
      <column name="root_process_instance_key"/>
    </createIndex>
  </changeSet>

  <!--
    The request awaiting the result of a process instance, with the msgpack
    AwaitProcessInstanceResultMetadata.
  -->
  <changeSet id="create-await-process-instance-result" author="camunda">
    <createTable tableName="CAM_RU_AWAIT_PROCESS_INSTANCE_RESULT">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="root_process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tenant_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="payload" type="${engineState.binaryType}">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_AWAIT_PROCESS_INSTANCE_RESULT"
      constraintName="CAM_RU_AWAIT_PROCESS_INSTANCE_RESULT_PKEY"
      columnNames="partition_id, process_instance_key"/>
    <createIndex tableName="CAM_RU_AWAIT_PROCESS_INSTANCE_RESULT" indexName="CAM_RU_AWAIT_PROCESS_INSTANCE_RESULT_ROOT_INSTANCE">
      <column name="partition_id"/>
      <column name="root_process_instance_key"/>
    </createIndex>
  </changeSet>

  <!-- Runtime instructions of a process instance, with the msgpack RuntimeInstructions. -->
  <changeSet id="create-runtime-instructions" author="camunda">
    <createTable tableName="CAM_RU_RUNTIME_INSTRUCTIONS">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="root_process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tenant_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="payload" type="${engineState.binaryType}">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_RUNTIME_INSTRUCTIONS" constraintName="CAM_RU_RUNTIME_INSTRUCTIONS_PKEY"
      columnNames="partition_id, process_instance_key"/>
    <createIndex tableName="CAM_RU_RUNTIME_INSTRUCTIONS" indexName="CAM_RU_RUNTIME_INSTRUCTIONS_ROOT_INSTANCE">
      <column name="partition_id"/>
      <column name="root_process_instance_key"/>
    </createIndex>
  </changeSet>

  <!--
    Variables by scope and name, as stored by RdbmsVariableStore. A scope is an element instance,
    whose parent scope is its parent_key, so there is no table of the scope hierarchy. value is the
    variable's msgpack value, metadata its msgpack VariableMetadataRecord (e.g. protection modes).
    A scope can get variables before its element instance is created (e.g. the input element of a
    multi-instance inner instance), so the process instance columns come from the variable record
    in that case.
  -->
  <changeSet id="create-variable" author="camunda">
    <createTable tableName="CAM_RU_VARIABLE">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="scope_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="variable_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="root_process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tenant_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="value" type="${engineState.binaryType}">
        <constraints nullable="false"/>
      </column>
      <column name="metadata" type="${engineState.binaryType}">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_VARIABLE" constraintName="CAM_RU_VARIABLE_PKEY"
      columnNames="partition_id, scope_key, name"/>
    <createIndex tableName="CAM_RU_VARIABLE" indexName="CAM_RU_VARIABLE_ROOT_INSTANCE">
      <column name="partition_id"/>
      <column name="root_process_instance_key"/>
    </createIndex>
    <createIndex tableName="CAM_RU_VARIABLE" indexName="CAM_RU_VARIABLE_PROCESS_INSTANCE">
      <column name="partition_id"/>
      <column name="process_instance_key"/>
    </createIndex>
  </changeSet>

  <!--
    The variable document of an update that waits for a user task's update transition, at most
    one per scope, with the msgpack VariableDocumentState.
  -->
  <changeSet id="create-variable-document-state" author="camunda">
    <createTable tableName="CAM_RU_VARIABLE_DOCUMENT_STATE">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="scope_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="root_process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tenant_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="payload" type="${engineState.binaryType}">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_VARIABLE_DOCUMENT_STATE"
      constraintName="CAM_RU_VARIABLE_DOCUMENT_STATE_PKEY"
      columnNames="partition_id, scope_key"/>
    <createIndex tableName="CAM_RU_VARIABLE_DOCUMENT_STATE" indexName="CAM_RU_VARIABLE_DOCUMENT_STATE_ROOT_INSTANCE">
      <column name="partition_id"/>
      <column name="root_process_instance_key"/>
    </createIndex>
  </changeSet>

  <!--
    Jobs, as stored by RdbmsJobStore: one row per job with its state (the stable code of
    JobState.State), the msgpack JobRecord without variables as payload (the source of truth for
    reads), and columns that follow the record for readability (type, element_instance_key,
    bpmn_process_id, element_id, job_kind as stable code, retries, and worker, NULL if empty).

    The lookups of the RocksDB state are nullable columns, NULL while the job has no such entry,
    and set and cleared by the same writes as the RocksDB entries, so they can disagree with the
    record (e.g. the record keeps its deadline after the job left ACTIVATED):
    - activatable_type, inverted_priority: the entry for activation by workers of the type, of
      the job's tenant_id, served by ascending inverted_priority (= -priority) and job_key
    - deadline: the timeout, served by deadline and job_key
    - backoff: the time the job recurs after a failure, served by backoff and job_key
    A job has at most one entry per lookup. The jobs of a process instance are found by the
    process_instance_key, which every job has.
  -->
  <changeSet id="create-job" author="camunda">
    <createTable tableName="CAM_RU_JOB">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="job_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="state" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="type" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="tenant_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="activatable_type" type="${engineState.textType}"/>
      <column name="inverted_priority" type="BIGINT"/>
      <column name="deadline" type="BIGINT"/>
      <column name="backoff" type="BIGINT"/>
      <column name="process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="root_process_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="element_instance_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="bpmn_process_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="element_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="job_kind" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="retries" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="worker" type="${engineState.textType}"/>
      <column name="payload" type="${engineState.binaryType}">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_JOB" constraintName="CAM_RU_JOB_PKEY"
      columnNames="partition_id, job_key"/>
    <!-- the tenant is filtered from the index -->
    <createIndex tableName="CAM_RU_JOB" indexName="CAM_RU_JOB_ACTIVATABLE">
      <column name="partition_id"/>
      <column name="activatable_type"/>
      <column name="inverted_priority"/>
      <column name="job_key"/>
      <column name="tenant_id"/>
    </createIndex>
    <createIndex tableName="CAM_RU_JOB" indexName="CAM_RU_JOB_DEADLINE">
      <column name="partition_id"/>
      <column name="deadline"/>
      <column name="job_key"/>
    </createIndex>
    <createIndex tableName="CAM_RU_JOB" indexName="CAM_RU_JOB_BACKOFF">
      <column name="partition_id"/>
      <column name="backoff"/>
      <column name="job_key"/>
    </createIndex>
    <createIndex tableName="CAM_RU_JOB" indexName="CAM_RU_JOB_PROCESS_INSTANCE">
      <column name="partition_id"/>
      <column name="process_instance_key"/>
      <column name="job_key"/>
    </createIndex>
    <createIndex tableName="CAM_RU_JOB" indexName="CAM_RU_JOB_ROOT_INSTANCE">
      <column name="partition_id"/>
      <column name="root_process_instance_key"/>
    </createIndex>
  </changeSet>

  <!-- Process definitions and their lookups, as stored by RdbmsProcessStore. -->

  <!--
    Deployed processes. Hybrid row: the full PersistedProcess, including the BPMN resource, is
    kept as its msgpack payload (the source of truth for reads); the other columns are derived
    from it on every write so they can be queried and indexed. version_tag is NULL for a process
    without one, since Oracle stores an empty string as NULL anyway. deployment_key is -1 for a
    process deployed before processes knew their deployment.

    The lookups by deployment key and by version tag are the indexed columns deployment_key_lookup
    and version_tag_lookup. They are not derived from the other columns, but set and cleared by the
    same writes as the RocksDB state's lookup entries, and can disagree with the definitions:
    processes deployed before 8.6 have no deployment lookup (NULL), and deleting a process with the
    Process:DELETED v1 applier clears the version tag lookup even if other versions carry the tag.
    At most one process of a process id has a given lookup value. NULL never matches a lookup.

    deployment_key_lookup is not redundant to deployment_key. For a deployment key > 0 they agree:
    a deployment contains a process id once, and Process:CREATED v2 and Deployment:RECONSTRUCTED
    set both together. But a partition that gets a deployment from a pre-8.6 partition during a
    rolling update creates its processes with Process:CREATED v2 and deployment key -1, and each
    takes over the single lookup of -1, while the processes of Process:CREATED v1 and
    Deployment:DISTRIBUTED have -1 without lookup. A call activity with binding type deployment in a
    process without deployment key looks up -1, and RocksDB finds only the last such v2 process.
  -->
  <changeSet id="create-process-definition" author="camunda">
    <createTable tableName="CAM_RU_PROCESS_DEFINITION">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="process_definition_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tenant_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="bpmn_process_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="version" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="version_tag" type="${engineState.textType}"/>
      <column name="deployment_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="resource_name" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="state" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="deployment_key_lookup" type="BIGINT"/>
      <column name="version_tag_lookup" type="${engineState.textType}"/>
      <column name="payload" type="${engineState.binaryType}">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_PROCESS_DEFINITION"
      constraintName="CAM_RU_PROCESS_DEFINITION_PKEY"
      columnNames="partition_id, process_definition_key"/>
    <!-- not unique: like the RocksDB state, a version may be stored again under another key -->
    <createIndex tableName="CAM_RU_PROCESS_DEFINITION" indexName="CAM_RU_PROCESS_DEFINITION_BY_VERSION">
      <column name="partition_id"/>
      <column name="tenant_id"/>
      <column name="bpmn_process_id"/>
      <column name="version"/>
    </createIndex>
    <createIndex tableName="CAM_RU_PROCESS_DEFINITION" indexName="CAM_RU_PROCESS_DEFINITION_BY_DEPLOYMENT">
      <column name="partition_id"/>
      <column name="tenant_id"/>
      <column name="bpmn_process_id"/>
      <column name="deployment_key_lookup"/>
    </createIndex>
    <createIndex tableName="CAM_RU_PROCESS_DEFINITION" indexName="CAM_RU_PROCESS_DEFINITION_BY_VERSION_TAG">
      <column name="partition_id"/>
      <column name="tenant_id"/>
      <column name="bpmn_process_id"/>
      <column name="version_tag_lookup"/>
    </createIndex>
  </changeSet>

  <!--
    The versions of a process id: the highest version ever deployed, so versions are never
    reused after a deletion, and the versions that still exist. The payload is the VersionInfo;
    the version columns are derived from it for readability. The digest is the checksum of the
    latest deployed version, to detect duplicates; NULL if there is none, while the row, i.e. the
    version info, exists.
  -->
  <changeSet id="create-process-version" author="camunda">
    <createTable tableName="CAM_RU_PROCESS_VERSION">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="tenant_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="bpmn_process_id" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="highest_version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="latest_version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="digest" type="${engineState.binaryType}"/>
      <column name="payload" type="${engineState.binaryType}">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_PROCESS_VERSION"
      constraintName="CAM_RU_PROCESS_VERSION_PKEY"
      columnNames="partition_id, tenant_id, bpmn_process_id"/>
  </changeSet>

  <!--
    The partitions that still owe a drain report before a process definition can be deleted.
    pending_partition_id is that partition, partition_id the one storing the row.
  -->
  <changeSet id="create-pending-process-deletion" author="camunda">
    <createTable tableName="CAM_RU_PENDING_PROCESS_DELETION">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="process_definition_key" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="pending_partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_PENDING_PROCESS_DELETION"
      constraintName="CAM_RU_PENDING_PROCESS_DELETION_PKEY"
      columnNames="partition_id, process_definition_key, pending_partition_id"/>
  </changeSet>

  <!--
    Values of a partition's state by key, e.g. the marker that the startup restore of process
    definitions ran. A marker is a row, whose value may be NULL.
  -->
  <changeSet id="create-partition-state" author="camunda">
    <createTable tableName="CAM_RU_PARTITION_STATE">
      <column name="partition_id" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="state_key" type="${engineState.textType}">
        <constraints nullable="false"/>
      </column>
      <column name="value" type="${engineState.textType}"/>
    </createTable>
    <addPrimaryKey tableName="CAM_RU_PARTITION_STATE"
      constraintName="CAM_RU_PARTITION_STATE_PKEY"
      columnNames="partition_id, state_key"/>
  </changeSet>

</databaseChangeLog>
