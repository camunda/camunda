<!--
  Schema of the relational engine state (RdbmsEngineStateSchema). Tracked in its own Liquibase
  tables, CAM_RU_DATABASECHANGELOG and CAM_RU_DATABASECHANGELOGLOCK, so it evolves
  independently of the RDBMS exporter schema in the same database.
-->
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <include file="/db/changelog/engine-state/changesets/001-initial-schema.xml"/>
  <include file="/db/changelog/engine-state/changesets/002-process-definitions.xml"/>

</databaseChangeLog>
