<FindBugsFilter
  xmlns="https://github.com/spotbugs/filter/3.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <Match>
    <!-- A false positive: only the writer thread uses 'ready', always while holding queueLock.
         SpotBugs doesn't recognize ReentrantLock, and assumes that the methods reachable from the
         writer thread's Runnable may run at the same time. -->
    <Class name="io.camunda.zeebe.db.cache.TransactionWriter"/>
    <Field name="ready"/>
    <Bug pattern="AT_UNSAFE_RESOURCE_ACCESS_IN_THREAD"/>
  </Match>
</FindBugsFilter>
