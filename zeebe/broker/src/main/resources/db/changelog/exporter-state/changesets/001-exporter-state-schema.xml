<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Liquibase would map BLOB to oid (a large object reference) on PostgreSQL, and H2 rejects BLOB in
    MODE=PostgreSQL.
  -->
  <property name="exporterState.binaryType" value="BYTEA" dbms="postgresql,h2"/>
  <property name="exporterState.binaryType" value="BLOB"/>

  <!--
    The position up to which each exporter of a partition exported, with the metadata it stored
    and the version of that metadata, as kept in RocksDB by ExportersState otherwise. A broker that
    takes the partition over continues each exporter from here.
  -->
  <changeSet id="create-exporter-state" author="camunda">
    <createTable tableName="CAM_RU_EXPORTER_STATE">
      <column name="partition_id" type="INT">
        <constraints primaryKey="true" primaryKeyName="CAM_RU_EXPORTER_STATE_PK" nullable="false"/>
      </column>
      <column name="exporter_id" type="VARCHAR(255)">
        <constraints primaryKey="true" primaryKeyName="CAM_RU_EXPORTER_STATE_PK" nullable="false"/>
      </column>
      <column name="exported_position" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="metadata_version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="metadata" type="${exporterState.binaryType}">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

</databaseChangeLog>
