<Configuration status="WARN">

  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout
        pattern="%d{HH:mm:ss.SSS} [%X] [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
    <!-- A stalled stdout must not block the threads that log. -->
    <Async name="AsyncConsole" bufferSize="16384">
      <AppenderRef ref="Console"/>
    </Async>
  </Appenders>

  <Loggers>
    <Logger name="io.camunda.zeebe" level="trace"/>
    <Logger name="com.google" level="debug"/>

    <Root level="info">
      <AppenderRef ref="AsyncConsole"/>
    </Root>
  </Loggers>

</Configuration>
