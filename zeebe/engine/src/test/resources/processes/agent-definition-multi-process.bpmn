    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MarkedSecond_1" sourceRef="StartEvent_MarkedSecond" targetRef="agent-task-second" />
    <bpmn:sequenceFlow id="Flow_MarkedSecond_2" sourceRef="agent-task-second" targetRef="EndEvent_MarkedSecond" />
  </bpmn:process>
