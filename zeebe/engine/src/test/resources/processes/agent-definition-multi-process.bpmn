    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MarkedFirst_1" sourceRef="StartEvent_MarkedFirst" targetRef="agent-task-first" />
    <bpmn:sequenceFlow id="Flow_MarkedFirst_2" sourceRef="agent-task-first" targetRef="EndEvent_MarkedFirst" />
  </bpmn:process>
  <bpmn:process id="process-multi-marked-second" isExecutable="true">
    <bpmn:startEvent id="StartEvent_MarkedSecond">
      <bpmn:outgoing>Flow_MarkedSecond_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="agent-task-second" name="agent-task-second">
