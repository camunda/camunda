  <bpmn:collaboration id="Collaboration_agent_multi_process">
    <bpmn:documentation>The Zeebe BPMN model Java Builder API has no fluent equivalent for authoring multiple &lt;process&gt; elements, collaborations, or pools/participants, so this fixture is hand-authored XML rather than generated via Bpmn.createProcess(...).</bpmn:documentation>
    <bpmn:participant id="Participant_MarkedFirst" name="process-multi-marked-first" processRef="process-multi-marked-first" />
    <bpmn:participant id="Participant_MarkedSecond" name="process-multi-marked-second" processRef="process-multi-marked-second" />
  </bpmn:collaboration>
  <bpmn:process id="process-multi-marked-first" isExecutable="true">
    <bpmn:startEvent id="StartEvent_MarkedFirst">
      <bpmn:outgoing>Flow_MarkedFirst_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="agent-task-first" name="agent-task-first">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent-task-job-first" />
        <zeebe:agentDefinition agentType="aiAgentTask" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MarkedFirst_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkedFirst_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_MarkedFirst">
