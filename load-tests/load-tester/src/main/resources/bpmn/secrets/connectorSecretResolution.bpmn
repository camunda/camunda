<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_secrets_connector" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Zeebe Modeler" exporterVersion="0.8.0">
  <bpmn:process id="connectorSecretResolution" name="Connector secret resolution benchmark" isExecutable="true">
    <bpmn:documentation>Drives the outbound-connector secret-resolution code path with real process
instance throughput, instead of hitting the /v2/secrets/resolve and /v2/secrets/list REST
endpoints directly. Each instance activates one io.camunda:http-json:1 job whose "headers"
input contains a {{secrets.BENCHMARK_TOKEN0}} placeholder; the connector runtime resolves it
through CentralStoreSecretProvider (legacy FALLBACK mode) before issuing the HTTP call, so the
benchmark measures the same gateway resolve-secrets call the standalone driver used to
exercise, but through the code path a real customer (e.g. Connectors-triggered secret
resolution) actually uses.

The task calls the connectors pod's own actuator health endpoint rather than an external
service: the goal is to measure secret-resolution overhead added to a job activation, not to
benchmark an arbitrary downstream HTTP target, and this avoids depending on external network
access from the load-test cluster.</bpmn:documentation>
    <bpmn:startEvent id="start" name="start">
      <bpmn:outgoing>toResolveSecret</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="resolveSecret" name="Call http-json with secret header">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="get" target="method" />
          <zeebe:input source="http://connectors:8080/actuator/health" target="url" />
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="={&#34;X-Benchmark-Secret&#34;: &#34;{{secrets.BENCHMARK_TOKEN0}}&#34;}" target="headers" />
          <zeebe:input source="10" target="connectionTimeoutInSeconds" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>toResolveSecret</bpmn:incoming>
      <bpmn:outgoing>toEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="toResolveSecret" sourceRef="start" targetRef="resolveSecret" />
    <bpmn:endEvent id="end" name="end">
      <bpmn:incoming>toEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="toEnd" sourceRef="resolveSecret" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="connectorSecretResolution">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="start">
        <dc:Bounds x="179" y="103" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="186" y="146" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_resolveSecret_di" bpmnElement="resolveSecret">
        <dc:Bounds x="292" y="81" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toResolveSecret_di" bpmnElement="toResolveSecret">
        <di:waypoint x="215" y="121" />
        <di:waypoint x="292" y="121" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="EndEvent_0hz2fmb_di" bpmnElement="end">
        <dc:Bounds x="464" y="103" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="473" y="146" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toEnd_di" bpmnElement="toEnd">
        <di:waypoint x="392" y="121" />
        <di:waypoint x="464" y="121" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
