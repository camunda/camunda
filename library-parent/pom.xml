<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda</groupId>
    <artifactId>zeebe-parent</artifactId>
    <version>8.7.36-SNAPSHOT</version>
    <relativePath>../parent/pom.xml</relativePath>
  </parent>

  <artifactId>camunda-library-parent</artifactId>
  <packaging>pom</packaging>

  <name>Camunda SDK Library Parent</name>
  <description>A parent pom for all SDK related artifacts such as clients as test tooling.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <!-- The Spring Boot version is managed explicitly here to avoid inheriting
    Spring Boot version from the parent pom.xml, which is the reference for internal modules.
    This allows decoupled control of the Spring Boot version for this user facing artifact. -->
    <version.spring-boot>3.4.13</version.spring-boot>
    <!-- Spring Framework 6.x is required for Spring Boot 3.x. Pinned explicitly for the same
    reason as version.spring-boot above: the parent pom.xml value can be a HeroDevs NES patch
    version that only resolves from Camunda's internal Nexus, which would break customer builds
    resolving this user facing artifact from Maven Central. -->
    <version.spring>6.2.19</version.spring>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The version.spring-boot / version.spring property overrides above only take effect
      for BOM imports declared in this POM: the ancestor parent/pom.xml already imports
      spring-boot-dependencies and spring-framework-bom using its own property values (HeroDevs
      NES tags), and those imports are expanded before these property overrides are visible to
      them. Re-declaring the imports here, using this POM's own properties, produces managed
      versions (spring-core, spring-context, spring-web, etc.) at the public OSS version, which
      take precedence over the ancestor's entries per Maven's "nearest definition wins"
      dependencyManagement merge rule. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${version.spring-boot}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-framework-bom</artifactId>
        <version>${version.spring}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <profile>
      <id>spring-boot-3.5</id>
      <properties>
        <!-- For testing Spring Boot 3.5 compatibility -->
        <version.spring-boot>3.5.16</version.spring-boot>
      </properties>
    </profile>
  </profiles>
</project>
