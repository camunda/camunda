{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "testCases": [
    {
      "name": "Happy path order processing",
      "description": "The order should be processed successfully from creation to shipping with tracking code received.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "order-process"
          },
          "variables": {
            "order_id": "order-1"
          },
          "startInstructions": [
            {
              "elementId": "task1"
            }
          ],
          "runtimeInstructions": [
            {
              "type": "TERMINATE_PROCESS_INSTANCE",
              "afterElementId": "task2"
            }
          ]
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "order-process"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "Conditional behavior auto-completes review task",
      "description": "Registers a conditional behavior before the process starts: when the review user task is active, complete it with approved=true.",
      "instructions": [
        {
          "type": "CONDITIONAL_BEHAVIOR",
          "name": "auto-complete-review-task",
          "conditions": [
            {
              "type": "ASSERT_ELEMENT_INSTANCE",
              "processInstanceSelector": {
                "processDefinitionId": "review-process"
              },
              "elementSelector": {
                "elementName": "Review Task"
              },
              "state": "IS_ACTIVE"
            },
            {
              "type": "ASSERT_USER_TASK",
              "userTaskSelector": {
                "taskName": "Review Task"
              },
              "state": "IS_CREATED"
            }
          ],
          "actions": [
            {
              "type": "COMPLETE_USER_TASK",
              "userTaskSelector": {
                "taskName": "Review Task"
              },
              "variables": {
                "approved": true
              }
            }
          ]
        },
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "review-process"
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "review-process"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "Isolated recording of an order that calls a shipping process",
      "description": "The instance holds its jobs from the cluster's workers and stands in for the processes it calls.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "order-process"
          },
          "variables": {
            "order_id": "order-1"
          },
          "reserveJobs": true,
          "stubCallActivities": true
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "charge-card"
          },
          "variables": {
            "paymentStatus": "APPROVED"
          }
        },
        {
          "type": "RELEASE_JOB",
          "jobSelector": {
            "elementId": "send-invoice"
          }
        },
        {
          "type": "STUB_CALL_ACTIVITY_COMPLETE",
          "elementSelector": {
            "elementId": "review-order"
          },
          "variables": {
            "approved": true
          }
        },
        {
          "type": "RUN_CALLED_PROCESS",
          "elementSelector": {
            "elementId": "ship-order"
          }
        },
        {
          "type": "STUB_CALL_ACTIVITY_THROW_ERROR",
          "elementSelector": {
            "elementId": "collect-payment"
          },
          "errorCode": "PAYMENT_DECLINED",
          "errorMessage": "The card was declined.",
          "variables": {
            "declineCode": 51
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "order-process"
          },
          "state": "IS_COMPLETED"
        }
      ]
    }
  ]
}
