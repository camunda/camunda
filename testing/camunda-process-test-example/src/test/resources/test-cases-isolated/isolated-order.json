{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.11/schema.json",
  "testCases": [
    {
      "name": "Stand in for the shipping process",
      "description": "The listed job types are held back from every worker, and the call activity completes without the shipping process ever running.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "isolated-order"
          },
          "variables": {
            "orderId": "A-1001"
          },
          "runtimeInstructions": [
            {
              "type": "RESERVE_JOBS",
              "jobTypes": ["charge-card", "send-invoice"],
              "jobReservationToken": "${jobReservationToken}"
            },
            {
              "type": "STUB_CALL_ACTIVITIES",
              "processIds": ["shipping", "notification"]
            }
          ]
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "ServiceTask_ChargeCard"
          },
          "jobReservationToken": "${jobReservationToken}",
          "variables": {
            "paymentStatus": "APPROVED"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "jobKind": "CALL_ACTIVITY_STUB",
            "elementId": "CallActivity_ShipOrder"
          },
          "variables": {
            "trackingCode": "TRK-1001"
          }
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "isolated-order"
          },
          "variables": {
            "trackingCode": "TRK-1001"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "ServiceTask_SendInvoice"
          },
          "jobReservationToken": "${jobReservationToken}"
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "isolated-order"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "Run the real shipping process, stub the notification it calls",
      "description": "Only 'notification' is listed, so the shipping call activity runs its real child while the notification call activity nested inside shipping is stubbed - stubbing is inherited down the tree. The reserved job types are inherited the same way, so the dispatch-parcel job of the real child is held back too.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "isolated-order"
          },
          "variables": {
            "orderId": "A-1002"
          },
          "runtimeInstructions": [
            {
              "type": "RESERVE_JOBS",
              "jobTypes": ["charge-card", "dispatch-parcel", "send-invoice"],
              "jobReservationToken": "${jobReservationToken}"
            },
            {
              "type": "STUB_CALL_ACTIVITIES",
              "processIds": ["notification"]
            }
          ]
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "ServiceTask_ChargeCard"
          },
          "jobReservationToken": "${jobReservationToken}"
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "ServiceTask_DispatchParcel"
          },
          "jobReservationToken": "${jobReservationToken}",
          "variables": {
            "trackingCode": "TRK-1002"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "jobKind": "CALL_ACTIVITY_STUB",
            "elementId": "CallActivity_NotifyCustomer"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "ServiceTask_SendInvoice"
          },
          "jobReservationToken": "${jobReservationToken}"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "isolated-order"
          },
          "variables": {
            "trackingCode": "TRK-1002"
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "isolated-order"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "The shipping process declines the order",
      "description": "A job that stands in for a called process takes a BPMN error like any other, so the error boundary event on the call activity is covered without a shipping process that fails.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "isolated-order"
          },
          "variables": {
            "orderId": "A-1003"
          },
          "runtimeInstructions": [
            {
              "type": "RESERVE_JOBS",
              "jobTypes": ["charge-card"],
              "jobReservationToken": "${jobReservationToken}"
            },
            {
              "type": "STUB_CALL_ACTIVITIES",
              "processIds": ["shipping", "notification"]
            }
          ]
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "ServiceTask_ChargeCard"
          },
          "jobReservationToken": "${jobReservationToken}"
        },
        {
          "type": "THROW_BPMN_ERROR_FROM_JOB",
          "jobSelector": {
            "jobKind": "CALL_ACTIVITY_STUB",
            "elementId": "CallActivity_ShipOrder"
          },
          "errorCode": "SHIPPING_DECLINED",
          "errorMessage": "The carrier refused the parcel."
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "isolated-order"
          },
          "elementSelector": {
            "elementId": "EndEvent_OrderDeclined"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "isolated-order"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "Let the real worker run the invoice job",
      "description": "'send-invoice' is not listed, so SendInvoiceWorker gets that job and runs for real while the charge-card job is driven by the test. Requires that worker to be running.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "isolated-order"
          },
          "variables": {
            "orderId": "A-1004"
          },
          "runtimeInstructions": [
            {
              "type": "RESERVE_JOBS",
              "jobTypes": ["charge-card"],
              "jobReservationToken": "${jobReservationToken}"
            },
            {
              "type": "STUB_CALL_ACTIVITIES",
              "processIds": ["shipping", "notification"]
            }
          ]
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "ServiceTask_ChargeCard"
          },
          "jobReservationToken": "${jobReservationToken}"
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "jobKind": "CALL_ACTIVITY_STUB",
            "elementId": "CallActivity_ShipOrder"
          },
          "variables": {
            "trackingCode": "TRK-1004"
          }
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "isolated-order"
          },
          "variables": {
            "invoiceNumber": "INV-A-1004"
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "isolated-order"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "Stub the call activities without reserving the jobs",
      "description": "The two switches are independent: this instance's service-task jobs are served to the real workers, while its call activity still starts no child.",
      "instructions": [
        {
          "type": "MOCK_JOB_WORKER_COMPLETE_JOB",
          "jobType": "charge-card"
        },
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "isolated-order"
          },
          "variables": {
            "orderId": "A-1006"
          },
          "runtimeInstructions": [
            {
              "type": "STUB_CALL_ACTIVITIES",
              "processIds": ["shipping", "notification"]
            }
          ]
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "jobKind": "CALL_ACTIVITY_STUB",
            "elementId": "CallActivity_ShipOrder"
          },
          "variables": {
            "trackingCode": "TRK-1006"
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "isolated-order"
          },
          "state": "IS_COMPLETED"
        }
      ]
    }
  ]
}
