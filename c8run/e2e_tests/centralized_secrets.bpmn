<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_C8RunSecrets" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="c8runSecretPresent" isExecutable="true">
    <bpmn:startEvent id="presentStart">
      <bpmn:outgoing>presentToTask</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="presentToTask" sourceRef="presentStart" targetRef="presentTask" />
    <bpmn:serviceTask id="presentTask">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="c8run-secret-present" />
        <zeebe:ioMapping>
          <zeebe:input source="=camunda.secrets.C8RUN_E2E_SECRET" target="resolvedSecret" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>presentToTask</bpmn:incoming>
      <bpmn:outgoing>presentToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="presentToEnd" sourceRef="presentTask" targetRef="presentEnd" />
    <bpmn:endEvent id="presentEnd">
      <bpmn:incoming>presentToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="c8runSecretMissing" isExecutable="true">
    <bpmn:startEvent id="missingStart">
      <bpmn:outgoing>missingToTask</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="missingToTask" sourceRef="missingStart" targetRef="missingTask" />
    <bpmn:serviceTask id="missingTask">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="c8run-secret-missing" />
        <zeebe:ioMapping>
          <zeebe:input source="=camunda.secrets.C8RUN_E2E_MISSING" target="resolvedSecret" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>missingToTask</bpmn:incoming>
      <bpmn:outgoing>missingToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="missingToEnd" sourceRef="missingTask" targetRef="missingEnd" />
    <bpmn:endEvent id="missingEnd">
      <bpmn:incoming>missingToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
