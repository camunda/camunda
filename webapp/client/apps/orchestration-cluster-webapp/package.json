{
	"name": "@camunda/orchestration-cluster-webapp",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"preview": "vite preview",
		"build": "vite build && node ./renameProdIndex.mjs",
		"build:visual-regression": "vite build --mode visual-regression",
		"typecheck": "tsc -p tsconfig.browser.json && tsc -p tsconfig.vitest.json && tsc -p tsconfig.node.json",
		"extract-sbom": "vite build --mode sbom",
		"test:unit": "vitest",
		"test:unit:ui": "vitest --browser.headless=false",
		"test:a11y": "playwright test --project=a11y-light --project=a11y-dark",
		"test:visual": "cross-env CONTAINERIZED_BROWSER=true playwright test --project=visual-light --project=visual-dark --project=visual-light-tablet --project=visual-dark-tablet",
		"test:integration": "playwright test --project=integration",
		"generate:svg": "svgr --typescript --no-index --out-dir src/shared/svg src/shared/assets/svg",
		"lint:knip": "knip"
	},
	"dependencies": {
		"@bpmn-io/element-template-icon-renderer": "1.0.0",
		"@bpmn-io/form-js-carbon-styles": "1.25.0",
		"@bpmn-io/form-js-viewer": "1.25.0",
		"@bpmn-io/shadcn-theme": "0.0.1",
		"@camunda/camunda-api-zod-schemas": "0.0.92",
		"@camunda/camunda-composite-components": "0.25.4",
		"@camunda/design-system": "0.49.0",
		"@camunda/session-heartbeat": "0.0.1",
		"@carbon/grid": "11.61.0",
		"@carbon/layout": "11.58.0",
		"@carbon/react": "1.112.0",
		"@carbon/styles": "1.114.0",
		"@carbon/type": "11.66.0",
		"@devbookhq/splitter": "1.4.2",
		"@monaco-editor/react": "4.7.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-query": "5.102.3",
		"@tanstack/react-query-devtools": "5.102.3",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-virtual": "3.14.10",
		"@tanstack/router-plugin": "1.168.35",
		"@uidotdev/usehooks": "2.4.1",
		"@xstate/react": "6.1.0",
		"bpmn-js": "18.25.1",
		"bpmn-moddle": "10.1.0",
		"date-fns": "4.4.0",
		"diagram-js-minimap": "5.4.1",
		"dmn-js-decision-table": "17.10.2",
		"dmn-js-literal-expression": "17.10.2",
		"dmn-js-shared": "17.10.2",
		"final-form": "5.0.1",
		"final-form-arrays": "4.0.1",
		"i18next": "26.4.0",
		"i18next-browser-languagedetector": "8.2.1",
		"lodash": "4.18.1",
		"lucide-react": "1.35.0",
		"mobx": "7.0.3",
		"mobx-react-lite": "5.0.3",
		"monaco-editor": "0.53.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-error-boundary": "6.1.3",
		"react-final-form": "7.0.1",
		"react-final-form-arrays": "5.0.0",
		"react-i18next": "17.0.11",
		"react-transition-group": "4.4.5",
		"sass": "1.103.0",
