{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "type": "default",
  "id": "themePreviewForm",
  "components": [
    {
      "text": "# Request review\n",
      "type": "text",
      "id": "Field_preview_text",
      "layout": {
        "row": "Row_preview_text",
        "columns": null
      }
    },
    {
      "label": "Full name",
      "type": "textfield",
      "id": "Field_preview_full_name",
      "key": "full_name",
      "validate": {
        "required": true
      },
      "defaultValue": "Jane Doe",
      "layout": {
        "row": "Row_preview_1",
        "columns": 8
      }
    },
    {
      "label": "Case ID",
      "type": "textfield",
      "layout": {
        "row": "Row_preview_1",
        "columns": 8
      },
      "id": "Field_preview_case_id",
      "key": "case_id",
      "defaultValue": "CUST-4471",
      "readonly": true
    },
    {
      "label": "Amount",
      "type": "number",
      "id": "Field_preview_amount",
      "key": "amount",
      "validate": {
        "required": true
      },
      "defaultValue": 1250,
      "layout": {
        "row": "Row_preview_2",
        "columns": 8
      }
    },
    {
      "label": "Priority",
      "values": [
        {
          "label": "Low",
          "value": "option_1"
        },
        {
          "label": "Medium",
          "value": "option_2"
        },
        {
          "label": "High",
          "value": "option_3"
        }
      ],
      "type": "select",
      "id": "Field_preview_priority",
      "key": "priority",
      "validate": {
        "required": true
      },
      "defaultValue": "option_1",
      "layout": {
        "row": "Row_preview_2",
        "columns": 8
      }
    },
    {
      "subtype": "date",
      "dateLabel": "Due date",
      "type": "datetime",
      "id": "Field_preview_due_date",
      "key": "due_date",
      "defaultValue": "2023-04-05T16:06:09.526+0000",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_preview_3",
        "columns": 8
      }
    },
    {
      "label": "Tags",
      "values": [
        {
          "label": "Billing",
          "value": "billing"
        },
        {
          "label": "Urgent",
          "value": "urgent"
        },
        {
          "label": "Review",
          "value": "review"
        }
      ],
      "type": "taglist",
      "id": "Field_preview_tags",
      "key": "tags",
      "layout": {
        "row": "Row_preview_3",
        "columns": 8
      }
    },
    {
      "label": "Notify",
      "values": [
        {
          "label": "Requester",
          "value": "requester"
        },
        {
          "label": "Manager",
          "value": "manager"
        }
      ],
      "type": "checklist",
      "id": "Field_preview_notify",
      "key": "notify",
      "layout": {
        "row": "Row_preview_6",
        "columns": 8
      },
      "defaultValue": [
        "requester"
      ]
    },
    {
      "label": "Decision",
      "values": [
        {
          "label": "Approve",
          "value": "approve"
        },
        {
          "label": "Reject",
          "value": "reject"
        }
      ],
      "type": "radio",
      "id": "Field_preview_decision",
      "key": "decision",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_preview_6",
        "columns": 8
      },
      "defaultValue": "approve"
    },
    {
      "label": "Recent requests",
      "type": "table",
      "dataSource": "=tableSource",
      "rowCount": 10,
      "id": "Field_preview_table",
      "columns": [
        {
          "label": "ID",
          "key": "id"
        },
        {
          "label": "Name",
          "key": "name"
        },
        {
          "label": "Date",
          "key": "date"
        }
      ],
      "layout": {
        "row": "Row_Field_preview_table",
        "columns": null
      }
    },
    {
      "label": "Reset",
      "action": "reset",
      "type": "button",
      "id": "Field_preview_reset",
      "key": "reset",
      "layout": {
        "row": "Row_preview_7",
        "columns": null
      }
    }
  ]
}
