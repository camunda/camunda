<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="insurance-claim-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.11.0">
  <bpmn:process id="insurance-claim" name="Insurance claim" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:case title="claimTitle" caseForm="claim-case-details" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="claim-submitted" name="Claim submitted">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=[{label: &#34;Claimant&#34;, value: claimantName}, {label: &#34;Policy&#34;, value: policyNumber}, {label: &#34;Claim type&#34;, value: claimType}, {label: &#34;Reported on&#34;, value: string(today())}]" target="caseHeader" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow-to-registered</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow-to-registered" sourceRef="claim-submitted" targetRef="claim-registered" />
    <bpmn:subProcess id="claim-registered" name="Claim registered">
      <bpmn:extensionElements>
        <zeebe:stage />
        <zeebe:ioMapping>
          <zeebe:output source="=append(caseHeader, {label: &#34;Estimated damage&#34;, value: string(estimatedDamage) + &#34; EUR&#34;})" target="caseHeader" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow-to-registered</bpmn:incoming>
      <bpmn:outgoing>flow-to-routing</bpmn:outgoing>
      <bpmn:startEvent id="registered-start">
        <bpmn:outgoing>flow-registered-1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="register-claim" name="Register the claim">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="register-claim" />
          <zeebe:assignmentDefinition candidateGroups="claim-handlers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-registered-1</bpmn:incoming>
        <bpmn:outgoing>flow-registered-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="fraud-check" name="Fraud suspected?" default="flow-no-fraud">
        <bpmn:incoming>flow-registered-2</bpmn:incoming>
        <bpmn:outgoing>flow-fraud</bpmn:outgoing>
        <bpmn:outgoing>flow-no-fraud</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="fraud-suspected" name="Fraud suspected">
        <bpmn:incoming>flow-fraud</bpmn:incoming>
        <bpmn:escalationEventDefinition id="fraud-suspected-definition" escalationRef="escalation-fraud" />
      </bpmn:endEvent>
      <bpmn:endEvent id="registered-end">
        <bpmn:incoming>flow-no-fraud</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-registered-1" sourceRef="registered-start" targetRef="register-claim" />
      <bpmn:sequenceFlow id="flow-registered-2" sourceRef="register-claim" targetRef="fraud-check" />
      <bpmn:sequenceFlow id="flow-fraud" name="yes" sourceRef="fraud-check" targetRef="fraud-suspected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fraudSuspected</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="flow-no-fraud" name="no" sourceRef="fraud-check" targetRef="registered-end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow-to-routing" sourceRef="claim-registered" targetRef="damage-routing" />
    <bpmn:exclusiveGateway id="damage-routing" name="Damage above 10,000 EUR?" default="flow-skip-expert">
      <bpmn:incoming>flow-to-routing</bpmn:incoming>
      <bpmn:outgoing>flow-to-expert</bpmn:outgoing>
      <bpmn:outgoing>flow-skip-expert</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow-to-expert" name="yes" sourceRef="damage-routing" targetRef="expert-assessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=estimatedDamage &gt; 10000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-skip-expert" name="no" sourceRef="damage-routing" targetRef="coverage-check" />
    <bpmn:subProcess id="expert-assessment" name="Expert assessment">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-to-expert</bpmn:incoming>
      <bpmn:outgoing>flow-expert-to-coverage</bpmn:outgoing>
      <bpmn:startEvent id="expert-start">
        <bpmn:outgoing>flow-expert-1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="expert-split">
        <bpmn:incoming>flow-expert-1</bpmn:incoming>
        <bpmn:outgoing>flow-expert-inspect</bpmn:outgoing>
        <bpmn:outgoing>flow-expert-quotes</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="inspect-damage" name="Inspect the damage">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="inspect-damage" />
          <zeebe:assignmentDefinition candidateGroups="experts" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-expert-inspect</bpmn:incoming>
        <bpmn:outgoing>flow-inspect-join</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:subProcess id="collect-quotes" name="Collect repair quotes">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=[&#34;Garage Alpha&#34;, &#34;Garage Beta&#34;, &#34;Garage Gamma&#34;]" target="workshops" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>flow-expert-quotes</bpmn:incoming>
        <bpmn:outgoing>flow-quotes-join</bpmn:outgoing>
        <bpmn:startEvent id="quotes-start">
          <bpmn:outgoing>flow-quotes-1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="request-quote" name="Request a repair quote">
          <bpmn:extensionElements>
            <zeebe:userTask />
            <zeebe:formDefinition formId="request-quote" />
            <zeebe:assignmentDefinition candidateGroups="experts" />
            <zeebe:ioMapping>
              <zeebe:input source="=null" target="quote" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>flow-quotes-1</bpmn:incoming>
          <bpmn:outgoing>flow-quotes-2</bpmn:outgoing>
          <bpmn:multiInstanceLoopCharacteristics>
            <bpmn:extensionElements>
              <zeebe:loopCharacteristics inputCollection="=workshops" inputElement="workshop" outputCollection="quotes" outputElement="={workshop: workshop, amount: quote}" />
            </bpmn:extensionElements>
          </bpmn:multiInstanceLoopCharacteristics>
        </bpmn:userTask>
        <bpmn:endEvent id="quotes-end">
          <bpmn:incoming>flow-quotes-2</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="flow-quotes-1" sourceRef="quotes-start" targetRef="request-quote" />
        <bpmn:sequenceFlow id="flow-quotes-2" sourceRef="request-quote" targetRef="quotes-end" />
      </bpmn:subProcess>
      <bpmn:parallelGateway id="expert-join">
        <bpmn:incoming>flow-inspect-join</bpmn:incoming>
        <bpmn:incoming>flow-quotes-join</bpmn:incoming>
        <bpmn:outgoing>flow-expert-report</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:subProcess id="expert-report" name="Expert report">
        <bpmn:incoming>flow-expert-report</bpmn:incoming>
        <bpmn:outgoing>flow-expert-end</bpmn:outgoing>
        <bpmn:startEvent id="report-start">
          <bpmn:outgoing>flow-report-1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:subProcess id="draft-report" name="Draft the report">
          <bpmn:extensionElements>
            <zeebe:stage />
          </bpmn:extensionElements>
          <bpmn:incoming>flow-report-1</bpmn:incoming>
          <bpmn:outgoing>flow-report-2</bpmn:outgoing>
          <bpmn:startEvent id="draft-start">
            <bpmn:outgoing>flow-draft-1</bpmn:outgoing>
          </bpmn:startEvent>
          <bpmn:userTask id="write-report" name="Write the expert report">
            <bpmn:extensionElements>
              <zeebe:userTask />
              <zeebe:formDefinition formId="write-report" />
              <zeebe:assignmentDefinition candidateGroups="experts" />
            </bpmn:extensionElements>
            <bpmn:incoming>flow-draft-1</bpmn:incoming>
            <bpmn:outgoing>flow-draft-2</bpmn:outgoing>
          </bpmn:userTask>
          <bpmn:endEvent id="draft-end">
            <bpmn:incoming>flow-draft-2</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="flow-draft-1" sourceRef="draft-start" targetRef="write-report" />
          <bpmn:sequenceFlow id="flow-draft-2" sourceRef="write-report" targetRef="draft-end" />
        </bpmn:subProcess>
        <bpmn:userTask id="review-report" name="Review the expert report">
          <bpmn:extensionElements>
            <zeebe:userTask />
            <zeebe:formDefinition formId="review-report" />
            <zeebe:assignmentDefinition candidateGroups="claim-handlers" />
          </bpmn:extensionElements>
          <bpmn:incoming>flow-report-2</bpmn:incoming>
          <bpmn:outgoing>flow-report-3</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="report-end">
          <bpmn:incoming>flow-report-3</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="flow-report-1" sourceRef="report-start" targetRef="draft-report" />
        <bpmn:sequenceFlow id="flow-report-2" sourceRef="draft-report" targetRef="review-report" />
        <bpmn:sequenceFlow id="flow-report-3" sourceRef="review-report" targetRef="report-end" />
      </bpmn:subProcess>
      <bpmn:endEvent id="expert-end">
        <bpmn:incoming>flow-expert-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-expert-1" sourceRef="expert-start" targetRef="expert-split" />
      <bpmn:sequenceFlow id="flow-expert-inspect" sourceRef="expert-split" targetRef="inspect-damage" />
      <bpmn:sequenceFlow id="flow-expert-quotes" sourceRef="expert-split" targetRef="collect-quotes" />
      <bpmn:sequenceFlow id="flow-inspect-join" sourceRef="inspect-damage" targetRef="expert-join" />
      <bpmn:sequenceFlow id="flow-quotes-join" sourceRef="collect-quotes" targetRef="expert-join" />
      <bpmn:sequenceFlow id="flow-expert-report" sourceRef="expert-join" targetRef="expert-report" />
      <bpmn:sequenceFlow id="flow-expert-end" sourceRef="expert-report" targetRef="expert-end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow-expert-to-coverage" sourceRef="expert-assessment" targetRef="coverage-check" />
    <bpmn:adHocSubProcess id="coverage-check" name="Coverage check">
      <bpmn:extensionElements>
        <zeebe:stage />
        <zeebe:adHoc activeElementsCollection="=[&#34;check-policy&#34;, &#34;check-deductible&#34;]" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-skip-expert</bpmn:incoming>
      <bpmn:incoming>flow-expert-to-coverage</bpmn:incoming>
      <bpmn:incoming>flow-need-more-info</bpmn:incoming>
      <bpmn:outgoing>flow-to-decision</bpmn:outgoing>
      <bpmn:userTask id="check-policy" name="Check the policy">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="check-policy" />
          <zeebe:assignmentDefinition candidateGroups="claim-handlers" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="check-deductible" name="Check the deductible">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="check-deductible" />
          <zeebe:assignmentDefinition candidateGroups="claim-handlers" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="ask-customer" name="Ask the customer for details">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="ask-customer" />
          <zeebe:assignmentDefinition candidateGroups="claim-handlers" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="request-police-report" name="Request the police report">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="request-police-report" />
          <zeebe:assignmentDefinition candidateGroups="claim-handlers" />
        </bpmn:extensionElements>
      </bpmn:userTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="flow-to-decision" sourceRef="coverage-check" targetRef="decision" />
    <bpmn:subProcess id="decision" name="Decision">
      <bpmn:extensionElements>
        <zeebe:stage />
        <zeebe:ioMapping>
          <zeebe:output source="=append(caseHeader, {label: &#34;Decision&#34;, value: decision})" target="caseHeader" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow-to-decision</bpmn:incoming>
      <bpmn:outgoing>flow-to-decision-routing</bpmn:outgoing>
      <bpmn:startEvent id="decision-start">
        <bpmn:outgoing>flow-decision-1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="decide-claim" name="Decide on the claim">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="decide-claim" />
          <zeebe:assignmentDefinition candidateGroups="claim-managers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-decision-1</bpmn:incoming>
        <bpmn:outgoing>flow-decision-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="decision-end">
        <bpmn:incoming>flow-decision-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-decision-1" sourceRef="decision-start" targetRef="decide-claim" />
      <bpmn:sequenceFlow id="flow-decision-2" sourceRef="decide-claim" targetRef="decision-end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow-to-decision-routing" sourceRef="decision" targetRef="decision-routing" />
    <bpmn:exclusiveGateway id="decision-routing" name="Decision?" default="flow-rejected">
      <bpmn:incoming>flow-to-decision-routing</bpmn:incoming>
      <bpmn:outgoing>flow-approved</bpmn:outgoing>
      <bpmn:outgoing>flow-need-more-info</bpmn:outgoing>
      <bpmn:outgoing>flow-rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow-approved" name="approved" sourceRef="decision-routing" targetRef="payout">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-need-more-info" name="need more information" sourceRef="decision-routing" targetRef="coverage-check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "needMoreInfo"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-rejected" name="rejected" sourceRef="decision-routing" targetRef="claim-rejected" />
    <bpmn:endEvent id="claim-rejected" name="Claim rejected">
      <bpmn:incoming>flow-rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="payout" name="Payout">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-approved</bpmn:incoming>
      <bpmn:outgoing>flow-to-paid</bpmn:outgoing>
      <bpmn:startEvent id="payout-start">
        <bpmn:outgoing>flow-payout-1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="approve-payout" name="Approve the payout">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="approve-payout" />
          <zeebe:assignmentDefinition candidateGroups="claim-managers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-payout-1</bpmn:incoming>
        <bpmn:outgoing>flow-payout-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="payout-end">
        <bpmn:incoming>flow-payout-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-payout-1" sourceRef="payout-start" targetRef="approve-payout" />
      <bpmn:sequenceFlow id="flow-payout-2" sourceRef="approve-payout" targetRef="payout-end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow-to-paid" sourceRef="payout" targetRef="claim-paid" />
    <bpmn:endEvent id="claim-paid" name="Claim paid">
      <bpmn:incoming>flow-to-paid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="claim-withdrawn" name="Claim withdrawn" triggeredByEvent="true">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:startEvent id="withdrawn-start" name="Withdrawn">
        <bpmn:outgoing>flow-withdrawn-1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="withdrawn-start-definition" messageRef="message-claim-withdrawn" />
      </bpmn:startEvent>
      <bpmn:userTask id="confirm-withdrawal" name="Confirm the withdrawal">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="confirm-withdrawal" />
          <zeebe:assignmentDefinition candidateGroups="claim-handlers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-withdrawn-1</bpmn:incoming>
        <bpmn:outgoing>flow-withdrawn-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="withdrawn-end">
        <bpmn:incoming>flow-withdrawn-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-withdrawn-1" sourceRef="withdrawn-start" targetRef="confirm-withdrawal" />
      <bpmn:sequenceFlow id="flow-withdrawn-2" sourceRef="confirm-withdrawal" targetRef="withdrawn-end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="fraud-investigation" name="Fraud investigation" triggeredByEvent="true">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:startEvent id="fraud-start" name="Fraud suspected">
        <bpmn:outgoing>flow-fraud-1</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="fraud-start-definition" escalationRef="escalation-fraud" />
      </bpmn:startEvent>
      <bpmn:userTask id="investigate-fraud" name="Investigate the fraud">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="investigate-fraud" />
          <zeebe:assignmentDefinition candidateGroups="fraud-team" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-fraud-1</bpmn:incoming>
        <bpmn:outgoing>flow-fraud-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="fraud-end">
        <bpmn:incoming>flow-fraud-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-fraud-1" sourceRef="fraud-start" targetRef="investigate-fraud" />
      <bpmn:sequenceFlow id="flow-fraud-2" sourceRef="investigate-fraud" targetRef="fraud-end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="claim-expired" name="Claim expired" triggeredByEvent="true">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:startEvent id="expired-start" name="Deadline reached">
        <bpmn:outgoing>flow-expired-1</bpmn:outgoing>
        <bpmn:timerEventDefinition id="expired-start-definition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=claimDeadline</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:userTask id="close-expired-claim" name="Close the expired claim">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="close-expired-claim" />
          <zeebe:assignmentDefinition candidateGroups="claim-handlers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-expired-1</bpmn:incoming>
        <bpmn:outgoing>flow-expired-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="expired-end">
        <bpmn:incoming>flow-expired-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-expired-1" sourceRef="expired-start" targetRef="close-expired-claim" />
      <bpmn:sequenceFlow id="flow-expired-2" sourceRef="close-expired-claim" targetRef="expired-end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="customer-contact" name="Customer contact" triggeredByEvent="true">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:startEvent id="customer-called" name="Customer called" isInterrupting="false">
        <bpmn:outgoing>flow-contact-1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="customer-called-definition" messageRef="message-customer-called" />
      </bpmn:startEvent>
      <bpmn:userTask id="call-customer-back" name="Call the customer back">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="call-customer-back" />
          <zeebe:assignmentDefinition candidateGroups="claim-handlers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-contact-1</bpmn:incoming>
        <bpmn:outgoing>flow-contact-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="contact-end">
        <bpmn:incoming>flow-contact-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-contact-1" sourceRef="customer-called" targetRef="call-customer-back" />
      <bpmn:sequenceFlow id="flow-contact-2" sourceRef="call-customer-back" targetRef="contact-end" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:message id="message-claim-withdrawn" name="claim-withdrawn">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=claimId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="message-customer-called" name="customer-called">
