<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="loan-application-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.11.0">
  <bpmn:process id="loan-application" name="Loan application" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:case title="loanTitle" caseForm="loan-case-details" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="application-submitted" name="Application submitted">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=[{label: &#34;Owner&#34;, value: loanOfficer}, {label: &#34;Customer&#34;, value: applicantName}, {label: &#34;Amount&#34;, value: string(loanAmount) + &#34; EUR&#34;}, {label: &#34;Term&#34;, value: string(termYears) + &#34; years&#34;}, {label: &#34;Due date&#34;, value: string(today() + duration(&#34;P30D&#34;))}]" target="caseHeader" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow-to-received</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow-to-received" sourceRef="application-submitted" targetRef="application-received" />
    <bpmn:subProcess id="application-received" name="Application received">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-to-received</bpmn:incoming>
      <bpmn:outgoing>flow-to-documents</bpmn:outgoing>
      <bpmn:startEvent id="received-start">
        <bpmn:outgoing>flow-received-1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="review-application" name="Review application">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="review-application" />
          <zeebe:assignmentDefinition candidateGroups="loan-officers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-received-1</bpmn:incoming>
        <bpmn:outgoing>flow-received-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="received-end">
        <bpmn:incoming>flow-received-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-received-1" sourceRef="received-start" targetRef="review-application" />
      <bpmn:sequenceFlow id="flow-received-2" sourceRef="review-application" targetRef="received-end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow-to-documents" sourceRef="application-received" targetRef="documents-checked" />
    <bpmn:subProcess id="documents-checked" name="Documents checked">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-to-documents</bpmn:incoming>
      <bpmn:outgoing>flow-to-credit</bpmn:outgoing>
      <bpmn:startEvent id="documents-start">
        <bpmn:outgoing>flow-documents-1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="check-documents" name="Check documents">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="check-documents" />
          <zeebe:assignmentDefinition candidateGroups="loan-officers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-documents-1</bpmn:incoming>
        <bpmn:outgoing>flow-documents-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="documents-end">
        <bpmn:incoming>flow-documents-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-documents-1" sourceRef="documents-start" targetRef="check-documents" />
      <bpmn:sequenceFlow id="flow-documents-2" sourceRef="check-documents" targetRef="documents-end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow-to-credit" sourceRef="documents-checked" targetRef="credit-assessment" />
    <bpmn:adHocSubProcess id="credit-assessment" name="Credit assessment">
      <bpmn:extensionElements>
        <zeebe:stage />
        <zeebe:adHoc activeElementsCollection="=[&#34;retrieve-credit-score&#34;]" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-to-credit</bpmn:incoming>
      <bpmn:outgoing>flow-credit-completed</bpmn:outgoing>
      <bpmn:userTask id="retrieve-credit-score" name="Retrieve credit score">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="credit-score" />
          <zeebe:assignmentDefinition candidateGroups="underwriters" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="fetch-customer-history" name="Fetch customer history">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="customer-history" />
          <zeebe:assignmentDefinition candidateGroups="underwriters" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="request-document" name="Request a document from the applicant">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="request-document" />
          <zeebe:assignmentDefinition candidateGroups="underwriters" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:sendTask id="credit-assessment-done" name="I am done">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="case-stage-done" />
        </bpmn:extensionElements>
      </bpmn:sendTask>
      <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">=false</bpmn:completionCondition>
    </bpmn:adHocSubProcess>
    <bpmn:boundaryEvent id="credit-assessment-stage-done" name="Stage done" attachedToRef="credit-assessment">
      <bpmn:outgoing>flow-credit-done</bpmn:outgoing>
      <bpmn:messageEventDefinition id="credit-assessment-stage-done-definition" messageRef="message-credit-assessment-done" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow-credit-completed" sourceRef="credit-assessment" targetRef="underwriter-review" />
    <bpmn:sequenceFlow id="flow-credit-done" sourceRef="credit-assessment-stage-done" targetRef="underwriter-review" />
    <bpmn:subProcess id="underwriter-review" name="Underwriter review">
      <bpmn:extensionElements>
        <zeebe:stage />
        <zeebe:ioMapping>
          <zeebe:output source="=append(caseHeader, {label: &#34;Decision&#34;, value: decision})" target="caseHeader" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow-credit-completed</bpmn:incoming>
      <bpmn:incoming>flow-credit-done</bpmn:incoming>
      <bpmn:outgoing>flow-to-decision</bpmn:outgoing>
      <bpmn:startEvent id="underwriter-start">
        <bpmn:outgoing>flow-underwriter-1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="review-loan" name="Review loan">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="underwriter-review" />
          <zeebe:assignmentDefinition candidateGroups="underwriters" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-underwriter-1</bpmn:incoming>
        <bpmn:outgoing>flow-underwriter-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="underwriter-end">
        <bpmn:incoming>flow-underwriter-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-underwriter-1" sourceRef="underwriter-start" targetRef="review-loan" />
      <bpmn:sequenceFlow id="flow-underwriter-2" sourceRef="review-loan" targetRef="underwriter-end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow-to-decision" sourceRef="underwriter-review" targetRef="decision" />
    <bpmn:subProcess id="decision" name="Decision">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-to-decision</bpmn:incoming>
      <bpmn:outgoing>flow-to-end</bpmn:outgoing>
      <bpmn:startEvent id="decision-start">
        <bpmn:outgoing>flow-decision-1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="send-decision" name="Send the decision to the customer">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="loan-officers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-decision-1</bpmn:incoming>
        <bpmn:outgoing>flow-decision-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="decision-end">
        <bpmn:incoming>flow-decision-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-decision-1" sourceRef="decision-start" targetRef="send-decision" />
      <bpmn:sequenceFlow id="flow-decision-2" sourceRef="send-decision" targetRef="decision-end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow-to-end" sourceRef="decision" targetRef="loan-closed" />
    <bpmn:endEvent id="loan-closed" name="Loan closed">
      <bpmn:incoming>flow-to-end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="application-withdrawn" name="Application withdrawn" triggeredByEvent="true">
      <bpmn:extensionElements>
        <zeebe:stage />
      </bpmn:extensionElements>
      <bpmn:startEvent id="withdrawn-start" name="Withdrawn">
        <bpmn:outgoing>flow-withdrawn-1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="withdrawn-start-definition" messageRef="message-application-withdrawn" />
      </bpmn:startEvent>
      <bpmn:userTask id="thank-customer" name="Thank the customer">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="thank-customer" />
          <zeebe:assignmentDefinition candidateGroups="loan-officers" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow-withdrawn-1</bpmn:incoming>
        <bpmn:outgoing>flow-withdrawn-2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="withdrawn-end">
        <bpmn:incoming>flow-withdrawn-2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow-withdrawn-1" sourceRef="withdrawn-start" targetRef="thank-customer" />
      <bpmn:sequenceFlow id="flow-withdrawn-2" sourceRef="thank-customer" targetRef="withdrawn-end" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:message id="message-credit-assessment-done" name="credit-assessment-done">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=caseId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="message-application-withdrawn" name="application-withdrawn">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=caseId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="loan-application-diagram">
    <bpmndi:BPMNPlane id="loan-application-plane" bpmnElement="loan-application">
      <bpmndi:BPMNShape id="application-submitted_di" bpmnElement="application-submitted">
        <dc:Bounds x="100" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="80" y="225" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="application-received_di" bpmnElement="application-received" isExpanded="true">
        <dc:Bounds x="180" y="100" width="300" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="received-start_di" bpmnElement="received-start">
        <dc:Bounds x="210" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review-application_di" bpmnElement="review-application">
        <dc:Bounds x="280" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="received-end_di" bpmnElement="received-end">
        <dc:Bounds x="420" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-received-1_di" bpmnElement="flow-received-1">
        <di:waypoint x="246" y="200" />
        <di:waypoint x="280" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-received-2_di" bpmnElement="flow-received-2">
        <di:waypoint x="380" y="200" />
        <di:waypoint x="420" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="documents-checked_di" bpmnElement="documents-checked" isExpanded="true">
        <dc:Bounds x="540" y="100" width="300" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="documents-start_di" bpmnElement="documents-start">
        <dc:Bounds x="570" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check-documents_di" bpmnElement="check-documents">
        <dc:Bounds x="640" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="documents-end_di" bpmnElement="documents-end">
        <dc:Bounds x="780" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-documents-1_di" bpmnElement="flow-documents-1">
        <di:waypoint x="606" y="200" />
        <di:waypoint x="640" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-documents-2_di" bpmnElement="flow-documents-2">
        <di:waypoint x="740" y="200" />
        <di:waypoint x="780" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="credit-assessment_di" bpmnElement="credit-assessment" isExpanded="true">
        <dc:Bounds x="900" y="80" width="560" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="retrieve-credit-score_di" bpmnElement="retrieve-credit-score">
        <dc:Bounds x="930" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fetch-customer-history_di" bpmnElement="fetch-customer-history">
        <dc:Bounds x="1060" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request-document_di" bpmnElement="request-document">
        <dc:Bounds x="1190" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="credit-assessment-done_di" bpmnElement="credit-assessment-done">
        <dc:Bounds x="1320" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="credit-assessment-stage-done_di" bpmnElement="credit-assessment-stage-done">
        <dc:Bounds x="1442" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1483" y="163" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="underwriter-review_di" bpmnElement="underwriter-review" isExpanded="true">
        <dc:Bounds x="1540" y="100" width="300" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="underwriter-start_di" bpmnElement="underwriter-start">
        <dc:Bounds x="1570" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review-loan_di" bpmnElement="review-loan">
        <dc:Bounds x="1640" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="underwriter-end_di" bpmnElement="underwriter-end">
        <dc:Bounds x="1780" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-underwriter-1_di" bpmnElement="flow-underwriter-1">
        <di:waypoint x="1606" y="200" />
        <di:waypoint x="1640" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-underwriter-2_di" bpmnElement="flow-underwriter-2">
        <di:waypoint x="1740" y="200" />
        <di:waypoint x="1780" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="decision_di" bpmnElement="decision" isExpanded="true">
        <dc:Bounds x="1900" y="100" width="300" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision-start_di" bpmnElement="decision-start">
        <dc:Bounds x="1930" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send-decision_di" bpmnElement="send-decision">
        <dc:Bounds x="2000" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision-end_di" bpmnElement="decision-end">
        <dc:Bounds x="2140" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-decision-1_di" bpmnElement="flow-decision-1">
        <di:waypoint x="1966" y="200" />
        <di:waypoint x="2000" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-decision-2_di" bpmnElement="flow-decision-2">
        <di:waypoint x="2100" y="200" />
        <di:waypoint x="2140" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="loan-closed_di" bpmnElement="loan-closed">
        <dc:Bounds x="2272" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2261" y="225" width="58" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="application-withdrawn_di" bpmnElement="application-withdrawn" isExpanded="true">
        <dc:Bounds x="900" y="400" width="360" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="withdrawn-start_di" bpmnElement="withdrawn-start">
        <dc:Bounds x="930" y="472" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="922" y="515" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="thank-customer_di" bpmnElement="thank-customer">
        <dc:Bounds x="1010" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="withdrawn-end_di" bpmnElement="withdrawn-end">
        <dc:Bounds x="1170" y="472" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-withdrawn-1_di" bpmnElement="flow-withdrawn-1">
        <di:waypoint x="966" y="490" />
        <di:waypoint x="1010" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-withdrawn-2_di" bpmnElement="flow-withdrawn-2">
        <di:waypoint x="1110" y="490" />
        <di:waypoint x="1170" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-to-received_di" bpmnElement="flow-to-received">
        <di:waypoint x="136" y="200" />
        <di:waypoint x="180" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-to-documents_di" bpmnElement="flow-to-documents">
        <di:waypoint x="480" y="200" />
        <di:waypoint x="540" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-to-credit_di" bpmnElement="flow-to-credit">
        <di:waypoint x="840" y="200" />
        <di:waypoint x="900" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-credit-completed_di" bpmnElement="flow-credit-completed">
        <di:waypoint x="1460" y="280" />
        <di:waypoint x="1500" y="280" />
        <di:waypoint x="1500" y="250" />
        <di:waypoint x="1540" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-credit-done_di" bpmnElement="flow-credit-done">
        <di:waypoint x="1478" y="200" />
        <di:waypoint x="1540" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-to-decision_di" bpmnElement="flow-to-decision">
        <di:waypoint x="1840" y="200" />
        <di:waypoint x="1900" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-to-end_di" bpmnElement="flow-to-end">
        <di:waypoint x="2200" y="200" />
        <di:waypoint x="2272" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
