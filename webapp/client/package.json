{
	"name": "@camunda/webapp-client",
	"description": "Camunda JS/TS monorepo",
	"author": "Vinicius Goulart <vinicius.goulart@camunda.com>",
	"type": "module",
	"private": true,
	"license": "LicenseRef-Camunda-1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/camunda/camunda.git"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev:oc": "npm run dev -w @camunda/orchestration-cluster-webapp",
		"lint:oxlint": "oxlint --type-aware .",
		"lint:prettier": "prettier -c .",
		"lint:knip": "npm run lint:knip -w @camunda/orchestration-cluster-webapp",
		"lint": "npm run lint:oxlint && npm run lint:prettier && npm run lint:knip",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test:unit": "npm run test:unit --workspaces --if-present",
		"format": "prettier --write .",
		"build": "npm run build --workspaces --if-present",
		"prepublishOnly": "node scripts/prepublishOnly.js",
		"publish:oc-saas-notifications": "npm publish -w @camunda/oc-saas-notifications",
		"publish:zod-schemas": "npm run prepublishOnly && npm publish -w @camunda/camunda-api-zod-schemas",
		"publish:session-heartbeat": "npm run prepublishOnly && npm publish -w @camunda/session-heartbeat",
		"prettier:format": "prettier --write .",
		"postinstall": "patch-package"
	},
	"packageManager": "npm@12.2.1",
	"devDependencies": {
		"@camunda/design-system": "0.81.0",
		"@tanstack/eslint-plugin-query": "5.105.3",
		"eslint-plugin-license-header": "0.9.0",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2005",
		"patch-package": "8.0.1",
		"prettier": "3.9.10"
	},
	"version": "8.11.0-SNAPSHOT"
}
