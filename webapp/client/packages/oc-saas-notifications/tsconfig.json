{
	"compilerOptions": {
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "ES2022",
		"jsx": "react-jsx",
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		"module": "preserve",
		"moduleResolution": "bundler",
		"rootDir": "lib",

		"lib": ["ES2022", "DOM", "DOM.Iterable"],

		"noEmit": true
	},
	"include": ["lib"]
}
