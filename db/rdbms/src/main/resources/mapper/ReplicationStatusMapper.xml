<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.camunda.db.rdbms.sql.ReplicationStatusMapper">

  <resultMap id="replicationLsnStatusResultMap"
    type="io.camunda.db.rdbms.read.replication.ReplicationLsnStatus">
    <constructor>
      <arg column="logStatus" javaType="java.lang.Long" name="logStatus"/>
      <arg column="replicaId" javaType="java.lang.String" name="replicaId"/>
      <arg column="replicationLagMs" javaType="java.lang.Long" name="replicationLagMs"/>
      <arg column="replicatedUntilMs" javaType="java.lang.Long" name="replicatedUntilMs"/>
      <arg column="replicaLabel" javaType="java.lang.String" name="replicaLabel"/>
    </constructor>
  </resultMap>

  <select id="getCurrentLogStatus" resultType="java.lang.Long" databaseId="postgresql">
    SELECT pg_wal_lsn_diff(pg_current_wal_lsn(), '0/0')::bigint last_lsn
  </select>

  <!-- Postgres has no "last commit time" column, so the primary's own clock_timestamp() is used. -->
  <select id="getCurrentDbTime" resultType="java.lang.Long" databaseId="postgresql">
    SELECT (EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::bigint
  </select>

  <!-- Neither replicationLagMs nor replicatedUntilMs is coalesced when replay_lag is NULL, so an
       unmeasured replica (e.g. missing the pg_monitor grant - see hasRequiredPrivileges below) is
       never mistaken for one that is perfectly caught up. application_name is the replica's own
       self-declared label (set via its connection string), exposed as replicaLabel for optional
       replication region awareness - unlike pid, it stays stable across reconnects. -->
  <select id="getReplicationStatus" resultMap="replicationLsnStatusResultMap"
    databaseId="postgresql">
    SELECT COALESCE(pg_wal_lsn_diff(replay_lsn, '0/0'), 0)::bigint AS logStatus,
           pid::text                                               AS replicaId,
           (EXTRACT(EPOCH FROM replay_lag) * 1000)::bigint         AS replicationLagMs,
           (EXTRACT(EPOCH FROM (clock_timestamp() - replay_lag)) * 1000)::bigint
                                                                    AS replicatedUntilMs,
           application_name                                        AS replicaLabel
    FROM pg_stat_replication
    WHERE pid IS NOT NULL;
  </select>

  <!--
    MSSQL: last_commit_lsn are numeric(25,0) in sys.dm_hadr_database_replica_states,
    directly comparable as bigint for a test/dev database where LSN values stay small.
    database_id = DB_ID() scopes this to the database the exporter's own connection is using -
    sys.dm_hadr_database_replica_states returns one row per database participating in an AG on
    this instance, so without this filter a SQL Server hosting more than one database in the same
    AG would make this query return multiple rows for a single-value result.
  -->
  <select id="getCurrentLogStatus" resultType="java.lang.Long" databaseId="mssql">
    SELECT CONVERT(bigint, last_commit_lsn) AS last_lsn
    FROM sys.dm_hadr_database_replica_states
    WHERE is_local = 1 AND database_id = DB_ID()
  </select>

  <!--
    Reads the primary's OWN last_commit_time (is_local = 1), not GETDATE(), so it comes from the
    same MSSQL commit-time bookkeeping as the secondary's last_commit_time it's later compared
    against (see getReplicationStatus below) - avoiding skew between the exporter's clock and the
    database's. database_id = DB_ID() scopes this to the exporter's own database - see
    getCurrentLogStatus above for why that's necessary.
  -->
  <select id="getCurrentDbTime" resultType="java.lang.Long" databaseId="mssql">
    SELECT DATEDIFF_BIG(millisecond, '19700101', last_commit_time)
    FROM sys.dm_hadr_database_replica_states
    WHERE is_local = 1 AND database_id = DB_ID()
  </select>

  <!--
    MSSQL: replicationLagMs is the gap between the primary's and the secondary's last_commit_time,
    both read from sys.dm_hadr_database_replica_states and correlated via group_database_id (a
    GUID identifying the same AG-member database across replicas, unlike database_id which is a
    replica-local id). pri.database_id = DB_ID() scopes the primary side to the exporter's own
    database - see getCurrentLogStatus above for why that's necessary; the secondary side is then
    already correctly scoped transitively via the group_database_id join. replica_server_name -
    the name the replica was given when added to the availability group - is joined in from
    sys.availability_replicas and exposed as replicaLabel for optional replication region
    awareness; unlike replica_id (a GUID), it's a human-chosen, stable name.
      -->
  <select id="getReplicationStatus" resultMap="replicationLsnStatusResultMap" databaseId="mssql">
    SELECT CONVERT(bigint, ISNULL(secondary.last_commit_lsn, 0)) AS logStatus,
           CONVERT(nvarchar(36), secondary.replica_id)          AS replicaId,
           DATEDIFF_BIG(millisecond, secondary.last_commit_time, pri.last_commit_time) AS replicationLagMs,
           DATEDIFF_BIG(millisecond, '19700101', secondary.last_commit_time) AS replicatedUntilMs,
           ar.replica_server_name                                AS replicaLabel
    FROM sys.dm_hadr_database_replica_states secondary
           JOIN sys.dm_hadr_database_replica_states pri
                ON secondary.group_database_id = pri.group_database_id
                  AND pri.is_local = 1
                  AND pri.database_id = DB_ID()
           JOIN sys.availability_replicas ar
                ON ar.replica_id = secondary.replica_id
    WHERE secondary.is_local = 0
      AND secondary.last_commit_time IS NOT NULL
  </select>

  <!--
    Detects whether the connected PostgreSQL instance is AWS Aurora. Uses to_regprocedure to
    look up aurora_version() in the system catalog — returns null if the function does not exist,
    non-null if it does. Safe to run on any PostgreSQL-compatible database; never throws.
  -->
  <select id="isAurora" resultType="boolean" databaseId="postgresql">
    SELECT to_regprocedure('aurora_version()') IS NOT NULL
  </select>

  <!--
    Checks whether the current database user has the pg_monitor role (directly or via role
    inheritance) or is a superuser. Without pg_monitor the replay_lag column in
    pg_stat_replication is always NULL, causing replication lag to silently appear as zero
    and async replication confirmation to never happen correctly.
    pg_has_role returns true for superusers even without an explicit pg_monitor grant, so
    this check covers both cases.
  -->
  <select id="hasRequiredPrivileges" resultType="boolean" databaseId="postgresql">
    SELECT pg_has_role(current_user, 'pg_monitor', 'MEMBER')
  </select>

  <!--
    Checks whether the current SQL Server login holds the permission required to read
    replication status from sys.dm_hadr_database_replica_states:
      - SQL Server 2022+: VIEW SERVER PERFORMANCE STATE (the new, more granular permission)
      - SQL Server 2019 and earlier: VIEW SERVER STATE (covers all server-state DMVs)
    HAS_PERMS_BY_NAME returns NULL when the named permission does not exist in the current
    SQL Server version, so ISNULL(..., 0) treats an unknown permission as not granted, allowing
    this query to run safely on any SQL Server version without errors.
  -->
  <select id="hasRequiredPrivileges" resultType="boolean" databaseId="mssql">
    SELECT CASE
      WHEN HAS_PERMS_BY_NAME(null, null, 'VIEW SERVER STATE') = 1
        OR ISNULL(HAS_PERMS_BY_NAME(null, null, 'VIEW SERVER PERFORMANCE STATE'), 0) = 1
      THEN 1 ELSE 0 END
  </select>

  <!--
    Detects whether the connected MySQL instance is AWS Aurora MySQL. aurora_version() is a native
    engine function on Aurora MySQL, not a user routine, so it never appears in
    information_schema.ROUTINES (unlike PostgreSQL, where aurora_version() is a real catalog
    function). information_schema.replica_host_status is documented by AWS to exist on every
    Aurora MySQL cluster regardless of version or Global Database status, so check for that table
    instead. Safe to run on any MySQL-compatible database; never throws.
  -->
  <select id="isAurora" resultType="boolean" databaseId="mysql">
    SELECT EXISTS(SELECT 1
                  FROM information_schema.TABLES
                  WHERE TABLE_SCHEMA = 'information_schema'
                    AND TABLE_NAME = 'REPLICA_HOST_STATUS')
  </select>

  <!-- MySQL (Aurora) also has no "last commit time" column, so the primary's own clock is used. -->
  <select id="getCurrentDbTime" resultType="java.lang.Long" databaseId="mysql">
    SELECT CAST(UNIX_TIMESTAMP(NOW(3)) * 1000 AS SIGNED)
  </select>

  <!--
    Detects whether the connected Aurora PostgreSQL instance is part of a Global Database.
    Uses to_regprocedure to check for aurora_global_db_instance_status() without calling it.
    Safe to run on any PostgreSQL-compatible database; never throws.
  -->
  <select id="isAuroraGlobalDatabase" resultType="boolean" databaseId="postgresql">
    SELECT to_regprocedure('aurora_global_db_instance_status()') IS NOT NULL
  </select>

  <!--
    Detects whether the connected Aurora MySQL instance is part of a Global Database. Aurora MySQL
    exposes Global Database status as the information_schema.aurora_global_db_instance_status
    table (not a function). Available on Aurora MySQL 3.04.0+ and 8.4+ global databases. Safe to
    run on any MySQL-compatible database; never throws.
  -->
  <select id="isAuroraGlobalDatabase" resultType="boolean" databaseId="mysql">
    SELECT EXISTS(SELECT 1
                  FROM information_schema.TABLES
                  WHERE TABLE_SCHEMA = 'information_schema'
                    AND TABLE_NAME = 'AURORA_GLOBAL_DB_INSTANCE_STATUS')
  </select>

  <!--
    Returns the primary's current durable LSN for Aurora Global Database (PostgreSQL).
    The row with session_id = 'MASTER_SESSION_ID' identifies the primary writer.
  -->
  <select id="getAuroraCurrentLogStatus" resultType="java.lang.Long" databaseId="postgresql">
    SELECT COALESCE(durable_lsn, 0)
    FROM aurora_global_db_instance_status()
    WHERE session_id = 'MASTER_SESSION_ID'
  </select>

  <!--
    cluster_name is a built-in Postgres GUC (since 9.5), settable only at server start, meant
    exactly for per-instance self-identification - unlike application_name (a property of the
    connecting client, already used for replicaLabel on secondaries), this is a property of the
    server itself, so reading it live returns whichever physical instance currently serves as
    primary, correctly reflecting the region hosting it after a failover. Defaults to '' (never
    NULL) when unset, which optional region-awareness treats the same as no label.
  -->
  <select id="getCurrentReplicaLabel" resultType="java.lang.String" databaseId="postgresql">
    SELECT current_setting('cluster_name')
  </select>

  <!--
    MSSQL: mirrors getCurrentLogStatus/getCurrentDbTime above (is_local = 1 identifies the row for
    whichever replica this connection is local to - the primary when connected directly to it,
    reflecting a failover automatically) joined to sys.availability_replicas the same way
    getReplicationStatus already does for secondaries, to read this instance's own
    replica_server_name.
  -->
  <select id="getCurrentReplicaLabel" resultType="java.lang.String" databaseId="mssql">
    SELECT ar.replica_server_name
    FROM sys.dm_hadr_database_replica_states rs
           JOIN sys.availability_replicas ar
                ON ar.replica_id = rs.replica_id
    WHERE rs.is_local = 1 AND rs.database_id = DB_ID()
  </select>

  <!--
    Returns the primary's own server_id for Aurora Global Database (PostgreSQL) - the same column
    getAuroraReplicationStatus below already reads for secondaries, just from the MASTER_SESSION_ID
    row instead. Read live so a Global Database failover (which changes which region's instance
    holds MASTER_SESSION_ID) is reflected without any static config.
  -->
  <select id="getAuroraCurrentReplicaLabel" resultType="java.lang.String" databaseId="postgresql">
    SELECT server_id
    FROM aurora_global_db_instance_status()
    WHERE session_id = 'MASTER_SESSION_ID'
  </select>

  <!-- Aurora Global Database (MySQL) variant of getAuroraCurrentReplicaLabel above. -->
  <select id="getAuroraCurrentReplicaLabel" resultType="java.lang.String" databaseId="mysql">
    SELECT SERVER_ID
    FROM information_schema.aurora_global_db_instance_status
    WHERE SESSION_ID = 'MASTER_SESSION_ID'
  </select>

  <!--
    Returns the primary's current durable LSN for Aurora Global Database (MySQL). Reads from
    information_schema.aurora_global_db_instance_status (table, not function on MySQL).
    The row with SESSION_ID = 'MASTER_SESSION_ID' identifies the primary writer.
  -->
  <select id="getAuroraCurrentLogStatus" resultType="java.lang.Long" databaseId="mysql">
    SELECT COALESCE(DURABLE_LSN, 0)
    FROM information_schema.aurora_global_db_instance_status
    WHERE SESSION_ID = 'MASTER_SESSION_ID'
  </select>

  <!--
    Returns per-replica replication status for Aurora Global Database (PostgreSQL). Each non-primary
    instance reports its durable_lsn together with visibility_lag_in_msec; neither replicationLagMs
    nor replicatedUntilMs (the database's own current time minus that lag) is coalesced when the lag
    itself is NULL, so an unmeasured replica is never mistaken for one that is perfectly caught up.
    server_id is also exposed as replicaLabel for optional replication region awareness - each
    secondary instance in a Global Database lives in its own AWS region, so an operator-provided
    naming convention on server_id (or the instance's endpoint) is what a region pattern matches
    against.
  -->
  <select id="getAuroraReplicationStatus" resultMap="replicationLsnStatusResultMap"
    databaseId="postgresql">
    SELECT COALESCE(durable_lsn, 0) AS logStatus,
           server_id                AS replicaId,
           visibility_lag_in_msec   AS replicationLagMs,
           (EXTRACT(EPOCH FROM clock_timestamp()) * 1000 - visibility_lag_in_msec)::bigint
                                     AS replicatedUntilMs,
           server_id                AS replicaLabel
    FROM aurora_global_db_instance_status()
    WHERE session_id != 'MASTER_SESSION_ID'
  </select>

  <!--
    Returns per-replica replication status for Aurora Global Database (MySQL). Reads from
    information_schema.aurora_global_db_instance_status (table, not function on MySQL);
    replicationLagMs/replicatedUntilMs mirror the PostgreSQL variant above, including leaving
    both un-coalesced when the lag itself is NULL. SERVER_ID is also exposed as replicaLabel -
    see the PostgreSQL variant above for why.
  -->
  <select id="getAuroraReplicationStatus" resultMap="replicationLsnStatusResultMap"
    databaseId="mysql">
    SELECT COALESCE(DURABLE_LSN, 0) AS logStatus,
           SERVER_ID                AS replicaId,
           VISIBILITY_LAG_IN_MSEC   AS replicationLagMs,
           CAST(UNIX_TIMESTAMP(NOW(3)) * 1000 AS SIGNED) - VISIBILITY_LAG_IN_MSEC
                                     AS replicatedUntilMs,
           SERVER_ID                AS replicaLabel
    FROM information_schema.aurora_global_db_instance_status
    WHERE SESSION_ID != 'MASTER_SESSION_ID'
  </select>

</mapper>

