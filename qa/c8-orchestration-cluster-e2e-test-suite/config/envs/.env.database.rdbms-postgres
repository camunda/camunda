# PostgreSQL secondary storage for the `camunda` service, loaded by
# docker-compose.yml's `env_file: envs/.env.database.${DATABASE}` when
# DATABASE=rdbms-postgres. Use it together with docker-compose.rdbms.yml,
# which defines the rdbms-postgres service and flips the storage type.
#
# Only the connection belongs here. CAMUNDA_DATA_SECONDARY_STORAGE_TYPE must
# be set in docker-compose.rdbms.yml instead: docker-compose.yml pins it to
# elasticsearch in the service's `environment:` block, which Compose gives
# precedence over this file.
#
# No ZEEBE_BROKER_CLUSTER_PARTITIONS_COUNT on purpose. The Elasticsearch env
# file raises it to 2; the RDBMS nightly leaves the distribution default of 1,
# and some API tests branch on the partition count.

DATABASE_CONTAINER_NAME=rdbms-postgres

CAMUNDA_DATA_SECONDARY_STORAGE_RDBMS_URL=jdbc:postgresql://rdbms-postgres:5432/camunda
CAMUNDA_DATA_SECONDARY_STORAGE_RDBMS_USERNAME=camunda
CAMUNDA_DATA_SECONDARY_STORAGE_RDBMS_PASSWORD=camunda
