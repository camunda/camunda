{
  "name": "orchestration-cluster-smoke-tests",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "cluster:up": "cd ./config && DATABASE=elasticsearch docker compose up -d camunda",
    "cluster:down": "cd ./config && DATABASE=elasticsearch docker compose down",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && eslint . && prettier -c .",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@camunda8/orchestration-cluster-api": "10.0.0",
    "@playwright/test": "1.62.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-license-header": "0.9.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
