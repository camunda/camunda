<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda</groupId>
    <artifactId>analytics-parent</artifactId>
    <version>8.10.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>analytics-store-elasticsearch</artifactId>
  <packaging>jar</packaging>
  <name>Analytics Store Elasticsearch</name>
  <description>The Elasticsearch backend of the analytics serving store: an implementation of the
    neutral DatasetSchemaManager / DatasetWriter / DatasetQueryClient seams over the Elasticsearch
    Java client. Derives an index + mapping from a compiled dataset, upserts cells/rows by a
    deterministic doc id, and transforms the neutral fetch spec into a search. Reuses
    search-client-connect for the connection (auth/TLS/plugins).</description>

  <dependencies>
    <!-- The neutral serving SPI + compiled dataset/schema model -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>analytics-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Connection wiring (ElasticsearchConnector + ConnectConfiguration) and the ES Java client -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>camunda-search-client-connect</artifactId>
    </dependency>
    <dependency>
      <groupId>co.elastic.clients</groupId>
      <artifactId>elasticsearch-java</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
