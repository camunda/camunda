<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda</groupId>
    <artifactId>analytics-parent</artifactId>
    <version>8.10.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>analytics-store-document</artifactId>
  <packaging>jar</packaging>
  <name>Analytics Store Document</name>
  <description>The document-backed analytics stores (control plane + serving), written once against
    OC's neutral DocumentBasedSearchClient / DocumentBasedWriteClient so a single implementation
    serves both Elasticsearch and OpenSearch. The thin per-backend clients come from
    search-client-elasticsearch / -opensearch; this module holds the shared spec/cell document
    mapping and query building.</description>

  <dependencies>
    <!-- The neutral serving/control-plane SPIs + compiled dataset model -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>analytics-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- OC's neutral document clients (DocumentBasedSearchClient/WriteClient) + query DSL -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>camunda-search-client-query-transformer</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
