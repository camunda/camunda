{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Optimize import from Zeebe: stalls, lag, throughput and errors per record type and partition",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "optimize"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "timezone": "browser",
  "title": "Optimize Import",
  "uid": "optimize-import",
  "version": 1,
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "label": "datasource",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(optimize_import_cycleDuration_seconds_count, namespace)",
        "includeAll": true,
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(optimize_import_cycleDuration_seconds_count, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(optimize_import_cycleDuration_seconds_count{namespace=~\"$namespace\"}, pod)",
        "includeAll": true,
        "multi": true,
        "name": "pod",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(optimize_import_cycleDuration_seconds_count{namespace=~\"$namespace\"}, pod)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(optimize_import_cycleDuration_seconds_count{namespace=~\"$namespace\"}, RECORD_TYPE)",
        "includeAll": true,
        "multi": true,
        "name": "record_type",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(optimize_import_cycleDuration_seconds_count{namespace=~\"$namespace\"}, RECORD_TYPE)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "record type"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(optimize_import_cycleDuration_seconds_count{namespace=~\"$namespace\"}, PARTITION_ID)",
        "includeAll": true,
        "multi": true,
        "name": "partition",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(optimize_import_cycleDuration_seconds_count{namespace=~\"$namespace\"}, PARTITION_ID)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 3,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health: is any mediator stalled, failing or saturated?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stalled mediators",
      "description": "Mediators (one per record type and partition) that completed no import cycle in the last 2 minutes. An idle mediator still completes an empty cycle at least every ~30s, so this only counts mediators that are stuck, e.g. on a database write that keeps failing (see 'Failed database writes').",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (RECORD_TYPE) (sum by (RECORD_TYPE, PARTITION_ID) (rate(optimize_import_cycleDuration_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"}[2m])) == 0) or on() vector(0)",
          "legendFormat": "{{RECORD_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed database writes (5m)",
      "description": "Failed attempts to write an imported page to Optimize's indices. A failed page is retried until it succeeds, so the mediator makes no progress while this is increasing. ERROR_TYPE tells why the write failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (RECORD_TYPE, ERROR_TYPE) (increase(optimize_import_dbWriteRetries_total{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"}[5m])) or on() vector(0)",
          "legendFormat": "{{RECORD_TYPE}} {{ERROR_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Import lag (worst partition)",
      "description": "How far Optimize's data is behind what Zeebe has exported. Keeps growing while a mediator is stalled, and stays below ~30s for an idle mediator that is caught up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (RECORD_TYPE) (time() - optimize_import_importedUntil_seconds{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"})",
          "legendFormat": "{{RECORD_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Mediator busy fraction",
      "description": "Fraction of time the busiest mediator of each record type spends importing. A mediator imports one page at a time, so close to 100% means it can't import any faster and lag grows if Zeebe keeps exporting at that rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (RECORD_TYPE) (rate(optimize_import_cycleDuration_seconds_sum{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"}[5m]))",
          "legendFormat": "{{RECORD_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Configured vs Zeebe partitions",
      "description": "Zeebe partitions minus the partitions Optimize is configured to import (zeebe.partitionCount, default 1). Below 0 means some partitions are never imported. Needs the Zeebe broker metrics in the same Prometheus.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(optimize_import_configuredPartitions{namespace=~\"$namespace\", pod=~\"$pod\"}) - count(count by (partition) (atomix_role{namespace=~\"$namespace\"}))",
          "legendFormat": "missing partitions",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Zeebe process index missing (15m)",
      "description": "Fetches that found no zeebe-record index of processes or process instances to read from, e.g. because of a wrong index prefix (zeebe.name) or the exporter not running. Expected only before Zeebe exported its first records. Indices of other record types only exist once such records are exported, see 'Zeebe index missing / s'.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (RECORD_TYPE) (increase(optimize_import_zeebeIndexMissing_total{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"PROCESS|PROCESS_INSTANCE\", PARTITION_ID=~\"$partition\"}[15m])) or on() vector(0)",
          "legendFormat": "{{RECORD_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Fetch page size reduced",
      "description": "Mediators fetching with a smaller page than configured. Optimize halves the page size after a failed fetch and only restores it gradually, so imports stay slower for a while after an Elasticsearch/OpenSearch problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (RECORD_TYPE) (optimize_import_fetchPageSize{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"} < on(namespace, pod) group_left max by (namespace, pod) (optimize_import_maxPageSize{namespace=~\"$namespace\", pod=~\"$pod\"})) or on() vector(0)",
          "legendFormat": "{{RECORD_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Mediator errors (15m)",
      "description": "Errors while fetching or mapping a page. The page is skipped and fetched again in the next cycle.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (RECORD_TYPE) (increase(optimize_import_mediatorErrors_total{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"}[15m]))",
          "legendFormat": "{{RECORD_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Lag: how far behind Zeebe is Optimize?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Import lag by partition",
      "description": "Now minus the time up to which a mediator has imported everything Zeebe exported. Grows while a mediator is stalled or can't keep up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - optimize_import_importedUntil_seconds{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"}",
          "legendFormat": "{{RECORD_TYPE}} p{{PARTITION_ID}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Record import latency p50 / p99",
      "description": "Time from Zeebe creating a record to Optimize storing it, for records imported in the window. Only covers imported records, so a stalled mediator shows no data here: use 'Import lag' for that.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (RECORD_TYPE, le) (rate(optimize_import_overallImportTime_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"}[$__rate_interval])))",
          "legendFormat": "p99 {{RECORD_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (RECORD_TYPE, le) (rate(optimize_import_overallImportTime_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"}[$__rate_interval])))",
          "legendFormat": "p50 {{RECORD_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Throughput: Optimize vs Zeebe",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Records imported / s vs exported by Zeebe / s",
      "description": "Optimize only fetches the intents it needs for some record types (e.g. PROCESS_INSTANCE), so for those its rate stays below Zeebe's even when caught up. For VARIABLE both rates match when caught up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (RECORD_TYPE) (rate(optimize_import_overallImportTime_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\", RECORD_TYPE=~\"$record_type\", PARTITION_ID=~\"$partition\"}[$__rate_interval]))",
          "legendFormat": "optimize {{RECORD_TYPE}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (valueType) (rate(zeebe_exporter_events_total{namespace=~\"$namespace\", action=\"exported\", valueType=~\"$record_type\"}[$__rate_interval]))",
