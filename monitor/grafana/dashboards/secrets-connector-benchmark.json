      "title": "Secret cache (populated by resolving secrets through the connector job)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "description": "Fraction of secret cache lookups served from cache: HIT / (HIT + MISS), per store. The cache-first signal for this benchmark \u2014 a cache-first run should climb toward 1, a store-miss run stays low. Emitted by CaffeineSecretCache (PR #59861).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": [],
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "id": 18,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (store) (rate(camunda_secret_cache_result_total{cluster=~\"$cluster\", namespace=~\"$namespace\", result=\"HIT\"}[$__rate_interval])) / clamp_min(sum by (store) (rate(camunda_secret_cache_result_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])), 1)",
          "format": "time_series",
          "instant": false,
          "legendFormat": "{{store}} hit rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Cache hit rate",
      "type": "timeseries"
    },
