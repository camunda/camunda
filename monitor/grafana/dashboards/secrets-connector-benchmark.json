          },
          "editorMode": "code",
          "expr": "sum by (store, result) (rate(camunda_secret_cache_result_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "format": "time_series",
          "instant": false,
          "legendFormat": "{{store}} {{result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Cache lookups by result",
