<!--
  SBE message schema for the Event Bridge internal protocol (gateway ↔ broker).

  Schema ID: 200 (chosen to avoid collision with Zeebe's existing schemas).
  All variable-length fields use the standard varDataEncoding composite from common-types.xml.
  Groups use the standard groupSizeEncoding composite.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
  package="io.camunda.eventbridge.protocol"
  id="200"
  version="3"
  semanticVersion="${project.version}"
  description="Event Bridge Protocol Schema"
  byteOrder="littleEndian">

  <!-- =====================================================================
       Shared types
       ===================================================================== -->
  <types>

    <composite name="messageHeader" description="Message identifiers and length of message root">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId" primitiveType="uint16"/>
      <type name="schemaId" primitiveType="uint16"/>
      <type name="version" primitiveType="uint16"/>
    </composite>

    <composite name="varDataEncoding">
      <type name="length" primitiveType="uint32" maxValue="2147483647"/>
      <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
    </composite>

    <composite name="groupSizeEncoding" description="Repeating group dimensions">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="numInGroup" primitiveType="uint16" semanticType="NumInGroup"/>
    </composite>

    <!-- Error codes shared across response messages -->
    <enum name="ErrorCode" encodingType="uint8">
      <validValue name="NONE">0</validValue>
      <validValue name="PARTITION_NOT_FOUND">1</validValue>
      <validValue name="LEADER_UNAVAILABLE">2</validValue>
      <validValue name="INVALID_REQUEST">3</validValue>
      <validValue name="CONSUMER_NOT_REGISTERED">4</validValue>
      <validValue name="COORDINATOR_UNAVAILABLE">5</validValue>
      <validValue name="POSITION_TRUNCATED">6</validValue>
      <validValue name="INVALID_PARAMETER">7</validValue>
      <validValue name="PARTITION_NOT_ASSIGNED">8</validValue>
    </enum>

    <enum name="CoordinateRequestType" encodingType="uint8">
      <validValue name="HEARTBEAT">0</validValue>
      <validValue name="JOIN_GROUP">1</validValue>
      <validValue name="LEAVE_GROUP">2</validValue>
    </enum>

    <enum name="PublishResponseStatus" encodingType="uint8"
      description="Status of a publish response">
      <validValue name="SUCCESS">0</validValue>
      <validValue name="ERROR">1</validValue>
    </enum>

    <enum name="RejectionReason" encodingType="uint8"
      description="Reason for rejecting a publish request">
      <validValue name="UNKNOWN">0</validValue>
      <validValue name="INVALID_REQUEST">1</validValue>
      <validValue name="BACKPRESSURE">2</validValue>
      <validValue name="NO_LEADER">3</validValue>
      <validValue name="SHUTTING_DOWN">4</validValue>
      <validValue name="WRITE_FAILURE">5</validValue>
    </enum>

  </types>

  <sbe:message name="ExecuteCoordinateRequest" id="1">
    <field name="type" id="1" type="CoordinateRequestType"/>
    <data name="value" id="2" type="varDataEncoding"/>
  </sbe:message>

  <sbe:message name="ExecuteCoordinateResponse" id="2">
    <data name="value" id="1" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       PublishBatchRequest (templateId=3): gateway → partition leader
       Carries a batch of raw event payloads to be appended to a partition.
       ===================================================================== -->
  <sbe:message name="ExecutePublishRequest" id="3" description="Publish a batch of events to a partition">
    <field name="entryCount" id="1" type="uint16" />
    <data name="entryBatch" id="2" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       PublishBatchResponse (templateId=2): partition leader → gateway
       ===================================================================== -->
  <sbe:message name="ExecutePublishResponse" id="4" description="Result of publishing a batch">
    <field name="status" id="1" type="PublishResponseStatus"/>
    <field name="rejectionReason" id="2" type="RejectionReason"/>
    <field name="firstPosition" id="3" type="int64"/>
    <field name="lastPosition" id="4" type="int64"/>
    <data  name="rejectionMessage" id="5" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       PollRequest (templateId=3): gateway → partition leader
       ===================================================================== -->
  <sbe:message name="PollRequest" id="5" description="Pull events from a partition log">
    <field name="partitionId" id="1" type="int32"/>
    <field name="fromPosition" id="2" type="int64"/>
    <field name="maxRecords" id="3" type="int32"/>
    <field name="serverWaitMs" id="4" type="int32"/>
    <field name="epoch" id="5" type="int64"/>
    <data name="groupId" id="6" type="varDataEncoding"/>
    <data name="consumerId" id="7" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       PollResponse (templateId=4): partition leader → gateway
       ===================================================================== -->
  <sbe:message name="PollResponse" id="6" description="Polled events or rebalance notification">
    <field name="errorCode" id="1" type="ErrorCode"/>
    <field name="nextPosition" id="2" type="int64"/>
    <field name="epoch" id="3" type="int64"/>
    <group name="events" id="4" dimensionType="groupSizeEncoding">
      <field name="position" id="5" type="int64"/>
      <data name="payload" id="6" type="varDataEncoding"/>
    </group>
    <data name="errorMessage" id="7" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       SubscribeRequest (templateId=7): gateway → coordinator
       ===================================================================== -->
  <sbe:message name="SubscribeRequest" id="7" description="[DEPRECATED] Register consumer and trigger rebalance">
    <data name="groupId" id="1" type="varDataEncoding"/>
    <data name="consumerId" id="2" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       SubscribeResponse (templateId=8): coordinator → gateway
       ===================================================================== -->
  <sbe:message name="SubscribeResponse" id="8" description="[DEPRECATED] Subscribe result with assigned partitions">
    <field name="errorCode" id="1" type="ErrorCode"/>
    <field name="generation" id="2" type="int64"/>
    <group name="assignedPartitions" id="3" dimensionType="groupSizeEncoding">
      <field name="partitionId" id="4" type="int32"/>
    </group>
    <data name="errorMessage" id="5" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       AckRequest (templateId=9): gateway → coordinator
       Sent by the consumer after processing heartbeat delta instructions.
       revoked: partition IDs the consumer has stopped processing.
       assigned: partition IDs the consumer has started processing.
       ===================================================================== -->
  <sbe:message name="AckRequest" id="9" description="Consumer acknowledgement of revoked and assigned partitions">
    <field name="epoch" id="1" type="int64"/>
    <group name="revoked" id="2" dimensionType="groupSizeEncoding">
      <field name="partitionId" id="3" type="int32"/>
    </group>
    <group name="assigned" id="4" dimensionType="groupSizeEncoding">
      <field name="partitionId" id="5" type="int32"/>
    </group>
    <data name="groupId" id="6" type="varDataEncoding"/>
    <data name="consumerId" id="7" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       AckResponse (templateId=10): coordinator → gateway
       ===================================================================== -->
  <sbe:message name="AckResponse" id="10" description="Result of an acknowledgement">
    <field name="errorCode" id="1" type="ErrorCode"/>
    <data name="errorMessage" id="2" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       FetchResponse (templateId=11): partition leader → gateway
       Batched, zero-copy read result. All metadata is fixed-size block fields;
       'data' is a single trailing var-data field carrying the raw, contiguous
       EventBridgeBatch bytes, which the broker streams via sendfile (the bytes
       are not copied through the JVM heap on the broker egress).
       ===================================================================== -->
  <sbe:message name="FetchResponse" id="11" description="Batched fetch result; data is raw EventBridgeBatch bytes">
    <field name="errorCode" id="1" type="ErrorCode"/>
    <field name="firstPosition" id="2" type="int64"/>
    <field name="lastPosition" id="3" type="int64"/>
    <field name="highWatermark" id="4" type="int64"/>
    <data name="data" id="5" type="varDataEncoding"/>
  </sbe:message>

  <!-- =====================================================================
       FetchRequest (templateId=12): gateway → partition leader
       ===================================================================== -->
  <sbe:message name="FetchRequest" id="12" description="Fetch a contiguous range of batches from a partition">
    <field name="partitionId" id="1" type="int32"/>
    <field name="fromPosition" id="2" type="int64"/>
    <field name="maxBytes" id="3" type="int32"/>
    <field name="minBytes" id="4" type="int32"/>
    <field name="maxWaitMs" id="5" type="int64"/>
  </sbe:message>

</sbe:messageSchema>
