<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda</groupId>
    <artifactId>event-bridge-parent</artifactId>
    <version>8.10.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>event-bridge-stream</artifactId>
  <packaging>jar</packaging>
  <name>Event Bridge Stream</name>
  <description>Shared stream-processing framework mirroring the Zeebe workflow engine: a command
    RecordProcessor base that turns commands into follow-up events and an event-applier registry
    (StateWriter + EventAppliers + TypedEventApplier) that is the single place state changes are
    applied — identically on the leader (on write) and on followers (on replay).</description>

  <dependencies>
    <!-- Request-handler registry shared by the partition lifecycles -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>event-bridge-transport</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Stream processor platform: RecordProcessor, ProcessingResultBuilder, TypedRecord -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-stream-platform</artifactId>
    </dependency>
    <!-- Zeebe protocol for Intent / RecordType / RecordMetadata -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-protocol-impl</artifactId>
    </dependency>
    <!-- LogStream append-only log -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-logstreams</artifactId>
    </dependency>
    <!-- Actor scheduler threading model -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-scheduler</artifactId>
    </dependency>
    <!-- RocksDB-backed ZeebeDb for replicated state -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-db</artifactId>
    </dependency>
    <!-- Broker partition primitives: StateController, AtomixLogStorage, AsyncSnapshotDirector,
         TopologyManagerImpl, AtomixRecordEntrySupplier -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-broker</artifactId>
    </dependency>
    <!-- Snapshot store (snapshot creation, replication, recovery) -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-snapshots</artifactId>
    </dependency>
    <!-- RAFT consensus and SWIM cluster membership -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-atomix-cluster</artifactId>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-util</artifactId>
    </dependency>

    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.agrona</groupId>
      <artifactId>agrona</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
