<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda</groupId>
    <artifactId>event-bridge-parent</artifactId>
    <version>8.10.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>event-bridge-pubsub</artifactId>
  <packaging>jar</packaging>
  <name>Event Bridge Pub/Sub</name>
  <description>The data-plane messaging domain: publishing (append) and consuming (fetch/poll) events over a
    partition log, with the high-watermark, flow control, and request handlers. Operates on a
    LogStorage and is independent of the Raft/partition platform that hosts it.</description>

  <dependencies>
    <!-- Event Bridge protocol + shared transport primitives -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>event-bridge-protocol</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>event-bridge-transport</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Append-only log storage the stream reads/writes -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-logstreams</artifactId>
    </dependency>
    <!-- Actor scheduler threading model -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-scheduler</artifactId>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-util</artifactId>
    </dependency>
    <!-- SWIM cluster messaging (request handlers) + transitive Netty for zero-copy fetch -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-atomix-cluster</artifactId>
    </dependency>

    <!-- Agrona direct buffers -->
    <dependency>
      <groupId>org.agrona</groupId>
      <artifactId>agrona</artifactId>
    </dependency>
  </dependencies>

</project>
