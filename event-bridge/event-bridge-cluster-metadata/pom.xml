<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda</groupId>
    <artifactId>event-bridge-parent</artifactId>
    <version>8.10.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>event-bridge-cluster-metadata</artifactId>
  <packaging>jar</packaging>
  <name>Event Bridge Cluster Metadata</name>
  <description>Cluster-wide control plane: the topic registry on its own Raft group, replicated via a
    Zeebe StreamProcessor. Every broker observes it (voter or passive) and reconciles its local topic
    Raft groups; the leader serves topic admin, placement, and reassignment.</description>

  <dependencies>
    <!-- Event Bridge shared types, protocol, and transport primitives -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>event-bridge-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>event-bridge-protocol</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>event-bridge-transport</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- RAFT consensus and SWIM cluster membership -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-atomix-cluster</artifactId>
    </dependency>
    <!-- LogStream append-only log -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-logstreams</artifactId>
    </dependency>
    <!-- Actor scheduler threading model -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-scheduler</artifactId>
    </dependency>
    <!-- Zeebe protocol for LogAppendEntry / RecordMetadata -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-protocol-impl</artifactId>
    </dependency>
    <!-- Snapshot store (snapshot creation, replication, recovery) -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-snapshots</artifactId>
    </dependency>
    <!-- Stream processor platform: state processing + follower replay + snapshots -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-stream-platform</artifactId>
    </dependency>
    <!-- RocksDB-backed ZeebeDb for the replicated topic registry -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-db</artifactId>
    </dependency>
    <!-- Broker partition primitives: StateController, AtomixLogStorage, AsyncSnapshotDirector,
         TopologyManagerImpl, AtomixRecordEntrySupplier -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-broker</artifactId>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-journal</artifactId>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>zeebe-util</artifactId>
    </dependency>

    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.agrona</groupId>
      <artifactId>agrona</artifactId>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
