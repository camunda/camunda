<!--
  SBE message schema for the segment-delta shuffle (combiner -> reducer).

  Schema id: 300 (chosen to avoid collision with the broker's schemas and the Event Bridge
  protocol's id 200). The SBE messageHeader carries schemaId + version, so the wire format is
  versioned and evolvable natively. The header lets the reducer dispatch on payloadKind + operation
  without decoding the payload.

  One envelope carries all of a sealed segment's cell deltas that route to one downstream partition,
  so (producerPartition, segment, chunk) is a single atomic dedup unit — the reducer merges the whole
  batch or none, and a re-emit is skipped wholesale. An oversized segment is split into ordered
  chunks to respect the transport's max record size; the chunk index keeps the dedup coordinate
  monotonic across a split.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
  package="io.camunda.eventbridge.streaming.shuffle.sbe"
  id="300"
  version="1"
  semanticVersion="${project.version}"
  description="Segment Shuffle Schema"
  byteOrder="littleEndian">

  <types>
    <composite name="messageHeader" description="Message identifiers and length of message root">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId" primitiveType="uint16"/>
      <type name="schemaId" primitiveType="uint16"/>
      <type name="version" primitiveType="uint16"/>
    </composite>

    <composite name="groupSizeEncoding" description="Repeating group dimensions">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="numInGroup" primitiveType="uint16" semanticType="NumInGroup"/>
    </composite>

    <composite name="varDataEncoding">
      <type name="length" primitiveType="uint32" maxValue="2147483647"/>
      <type name="varData" primitiveType="uint8" length="0"/>
    </composite>

    <!-- What the payload IS (the "valueType" analog): drives which reducer handler applies it. -->
    <enum name="PayloadKind" encodingType="uint8">
      <validValue name="AGGREGATE_DELTA">0</validValue>
      <validValue name="REFERENCE">1</validValue>
    </enum>

    <!-- What the reducer should DO with it (the "intent" analog). MERGE is non-idempotent and needs
         segment dedup; UPSERT/DELETE are idempotent by key and need none. -->
    <enum name="Operation" encodingType="uint8">
      <validValue name="MERGE">0</validValue>
      <validValue name="UPSERT">1</validValue>
      <validValue name="DELETE">2</validValue>
    </enum>
  </types>

  <!--
    One shuffled record: a batch of cell deltas for a sealed segment routed to one downstream
    partition. The fixed header carries dedup (producerPartition + segment + chunk) and dispatch
    (payloadKind + operation); the repeating group carries the per-cell deltas (targeted by streamId
    + key, in a window), each an encoded accumulator delta (or reference record). An oversized
    segment is split into ordered chunks; moreChunks flags that a further chunk of the same
    (producerPartition, segment) follows, so a chunked/truncated batch is self-describing on the wire.
  -->
  <sbe:message name="ShuffleEnvelope" id="1">
    <field name="producedAt" id="1" type="int64"/>
    <field name="schemaVersion" id="2" type="int32"/>
    <field name="producerPartition" id="3" type="int32"/>
    <field name="segment" id="4" type="int64"/>
    <field name="chunk" id="5" type="int32"/>
    <field name="moreChunks" id="6" type="uint8"/>
    <field name="payloadKind" id="7" type="PayloadKind"/>
    <field name="operation" id="8" type="Operation"/>
    <group name="cells" id="9" dimensionType="groupSizeEncoding">
      <field name="streamId" id="1" type="int32"/>
      <field name="windowStart" id="2" type="int64"/>
      <data name="key" id="3" type="varDataEncoding"/>
      <data name="payload" id="4" type="varDataEncoding"/>
    </group>
  </sbe:message>

</sbe:messageSchema>
